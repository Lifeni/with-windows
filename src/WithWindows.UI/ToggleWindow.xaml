<Window
    x:Class="WithWindows.ToggleWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 自绘标题栏 -->
        <Grid x:Name="TitleBarElement"
              Grid.Row="0"
              Height="44"
              Background="{ThemeResource LayerFillColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="16,0,0,0">
                <TextBlock Text="设置" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid ColumnSpacing="32" Padding="24,16,24,24" MaxWidth="920" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左栏：切换区域 -->
                <StackPanel Spacing="0">
                    <TextBlock Text="切换亮暗" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,12" />
                    <Button x:Name="ThemeCard"
                            Height="64"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Padding="14,0"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Click="OnToggleTheme">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE790;" FontSize="20" VerticalAlignment="Center" />
                            <TextBlock x:Name="ThemeStatusText" Grid.Column="1" VerticalAlignment="Center" />
                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="14" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <ToggleSwitch x:Name="AutoThemeToggle"
                                  Header="自动亮暗（日出日落）"
                                  OnContent="启用"
                                  OffContent="关闭"
                                  Toggled="OnAutoThemeToggled"
                                  Margin="0,12,0,0" />

                    <TextBlock Text="切换屏幕" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,24,0,12" />
                    <Button x:Name="DisplayCard"
                            Height="64"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Padding="14,0"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Click="OnToggleDisplay">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE7F4;" FontSize="20" VerticalAlignment="Center" />
                            <TextBlock x:Name="DisplayStatusText" Grid.Column="1" VerticalAlignment="Center" />
                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="14" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <TextBlock Text="切换模式（勾选参与循环切换的模式）"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Margin="0,12,0,8" />
                    <Grid ColumnSpacing="12" RowSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <CheckBox x:Name="ModeInternal" Content="仅当前屏幕" Tag="internal"
                                  Checked="OnModeChanged" Unchecked="OnModeChanged" />
                        <CheckBox x:Name="ModeExtend" Grid.Column="1" Content="扩展模式" Tag="extend"
                                  Checked="OnModeChanged" Unchecked="OnModeChanged" />
                        <CheckBox x:Name="ModeExternal" Grid.Row="1" Content="仅外接屏幕" Tag="external"
                                  Checked="OnModeChanged" Unchecked="OnModeChanged" />
                        <CheckBox x:Name="ModeClone" Grid.Row="1" Grid.Column="1" Content="复制模式" Tag="clone"
                                  Checked="OnModeChanged" Unchecked="OnModeChanged" />
                    </Grid>

                    <Button x:Name="RestoreDefaultsButton"
                            Content="恢复默认"
                            Click="OnRestoreDefaults"
                            HorizontalAlignment="Left"
                            Margin="0,24,0,0" />
                    <ToggleSwitch x:Name="AutoStartToggle"
                                  Header="开机自启"
                                  OnContent="开启"
                                  OffContent="关闭"
                                  Toggled="OnAutoStartToggled"
                                  Margin="0,12,0,0" />

                    <!-- 关于 -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,10"
                            Margin="0,24,0,0">
                        <StackPanel Spacing="2">
                            <TextBlock Text="With Windows" FontWeight="SemiBold" />
                            <TextBlock x:Name="VersionText" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 右栏：快捷键 + AI 设置 -->
                <Border Grid.Column="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1,0,0,0"
                        Padding="24,0,0,0">
                    <StackPanel Spacing="0">
                        <TextBlock Text="快捷键" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,12" />
                        <TextBlock Text="记事本" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Grid ColumnSpacing="8" Margin="0,4,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="NotepadHotkeyText" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="设置" Click="OnSetNotepadHotkey" />
                        </Grid>
                        <TextBlock Text="切换亮暗" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Grid ColumnSpacing="8" Margin="0,4,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ThemeHotkeyText" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="设置" Click="OnSetThemeHotkey" />
                        </Grid>
                        <TextBlock Text="切换屏幕" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Grid ColumnSpacing="8" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="DisplayHotkeyText" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="设置" Click="OnSetDisplayHotkey" />
                        </Grid>

                        <TextBlock Text="AI 设置" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,28,0,12" />
                        <TextBox x:Name="AiBaseUrl" Header="Base URL" PlaceholderText="http://127.0.0.1:11434/v1" />
                        <TextBox x:Name="AiApiKey" Header="API Key" PlaceholderText="留空则不携带" Margin="0,8,0,0" />
                        <TextBox x:Name="AiModel" Header="模型" PlaceholderText="如 qwen2.5" Margin="0,8,0,0" />
                        <Button x:Name="SaveAiButton" Content="保存 AI 配置" Click="OnSaveAiConfig"
                                HorizontalAlignment="Left" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <InfoBar x:Name="StatusBar"
                 Severity="Informational"
                 IsOpen="False"
                 IsClosable="False"
                 Margin="12,0" />
    </Grid>
</Window>
