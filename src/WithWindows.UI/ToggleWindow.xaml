<Window
    x:Class="WithWindows.ToggleWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 自绘标题栏 -->
        <Grid x:Name="TitleBarElement"
              Grid.Row="0"
              Height="44"
              Background="{ThemeResource LayerFillColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="16,0,0,0">
                <TextBlock Text="设置" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="20,12,20,20" Spacing="0" MaxWidth="520" HorizontalAlignment="Left">

                <!-- 开机自启置顶 -->
                <ToggleSwitch x:Name="AutoStartToggle"
                              Header="开机自启"
                              OnContent="开启"
                              OffContent="关闭"
                              Toggled="OnAutoStartToggled" />

                <!-- 快捷记事 -->
                <TextBlock Text="快捷记事" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,20,0,8" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="60" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="快捷键" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="NotepadHotkeyText" Grid.Column="1" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Content="设置" Click="OnSetNotepadHotkey" />
                </Grid>

                <!-- 切换投屏 -->
                <TextBlock Text="切换投屏" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,20,0,8" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="60" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="快捷键" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="DisplayHotkeyText" Grid.Column="1" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Content="设置" Click="OnSetDisplayHotkey" />
                </Grid>
                <TextBlock Text="切换模式（勾选参与循环切换的模式）"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Margin="0,12,0,8" />
                <Grid ColumnSpacing="12" RowSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <CheckBox x:Name="ModeInternal" Content="仅当前屏幕" Tag="internal"
                              Checked="OnModeChanged" Unchecked="OnModeChanged" />
                    <CheckBox x:Name="ModeExtend" Grid.Column="1" Content="扩展模式" Tag="extend"
                              Checked="OnModeChanged" Unchecked="OnModeChanged" />
                    <CheckBox x:Name="ModeExternal" Grid.Row="1" Content="仅外接屏幕" Tag="external"
                              Checked="OnModeChanged" Unchecked="OnModeChanged" />
                    <CheckBox x:Name="ModeClone" Grid.Row="1" Grid.Column="1" Content="复制模式" Tag="clone"
                              Checked="OnModeChanged" Unchecked="OnModeChanged" />
                </Grid>

                <Button x:Name="RestoreDefaultsButton"
                        Content="恢复默认"
                        Click="OnRestoreDefaults"
                        HorizontalAlignment="Left"
                        Margin="0,20,0,0" />

                <!-- 关于：纯文字 -->
                <TextBlock x:Name="AboutText"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           FontSize="12"
                           Margin="0,20,0,0" />
            </StackPanel>
        </ScrollViewer>

        <InfoBar x:Name="StatusBar"
                 Severity="Informational"
                 IsOpen="False"
                 IsClosable="False"
                 Margin="12,0" />
    </Grid>
</Window>
