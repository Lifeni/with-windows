<Window
    x:Class="WithWindows.ToggleWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WithWindows.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 自绘标题栏：随主题背景 + 系统按钮透明 -->
        <Grid x:Name="TitleBarElement"
              Grid.Row="0"
              Height="44"
              Background="{ThemeResource LayerFillColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="16,0,0,0">
                <Image Source="Assets/with-windows.png" Width="14" Height="14" />
                <TextBlock Text="一键切换" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- 内容：响应式（宽度自适应窗口） -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="24,16,24,24" Spacing="0" MaxWidth="720" HorizontalAlignment="Stretch">

                <!-- 亮暗 -->
                <TextBlock Text="切换亮暗" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,12" />
                <Grid ColumnSpacing="8" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="72" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="快捷键" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <controls:HotkeyInputBox x:Name="ThemeHotkey" Grid.Column="1" />
                    <Button x:Name="ToggleThemeButton" Grid.Column="2" Content="立即切换" Click="OnToggleTheme" />
                </Grid>
                <ToggleSwitch x:Name="AutoThemeToggle"
                              Header="日出日落自动切换"
                              OnContent="启用"
                              OffContent="关闭"
                              Toggled="OnAutoThemeToggled"
                              Margin="0,0,0,4" />
                <StackPanel x:Name="AutoThemeOptions" Spacing="8" Margin="0,8,0,0" Visibility="Collapsed">
                    <TextBlock Text="坐标与固定时间二选一（不填坐标时使用内置默认坐标）"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ThemeLatitude" Header="纬度" TextChanged="OnAutoSaveTextChanged" />
                        <TextBox x:Name="ThemeLongitude" Grid.Column="1" Header="经度" TextChanged="OnAutoSaveTextChanged" />
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ThemeSunrise" Header="固定日出（HH:mm）" TextChanged="OnAutoSaveTextChanged" />
                        <TextBox x:Name="ThemeSunset" Grid.Column="1" Header="固定日落（HH:mm）" TextChanged="OnAutoSaveTextChanged" />
                    </Grid>
                    <TextBox x:Name="ThemeOffset" Header="偏移分钟（正数 = 延后）" TextChanged="OnAutoSaveTextChanged" />
                </StackPanel>

                <!-- 屏幕 -->
                <TextBlock Text="切换屏幕" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,28,0,12" />
                <Grid ColumnSpacing="8" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="72" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="快捷键" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <controls:HotkeyInputBox x:Name="DisplayHotkey" Grid.Column="1" />
                    <Button x:Name="ToggleDisplayButton" Grid.Column="2" Content="立即切换" Click="OnToggleDisplay" />
                </Grid>
                <TextBlock Text="切换模式（勾选参与循环切换的模式）"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Grid ColumnSpacing="12" RowSpacing="4" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <CheckBox x:Name="ModeInternal" Content="仅当前屏幕" Tag="internal"
                              Checked="OnModeChanged" Unchecked="OnModeChanged" />
                    <CheckBox x:Name="ModeExtend" Grid.Column="1" Content="扩展模式" Tag="extend"
                              Checked="OnModeChanged" Unchecked="OnModeChanged" />
                    <CheckBox x:Name="ModeExternal" Grid.Row="1" Content="仅外接屏幕" Tag="external"
                              Checked="OnModeChanged" Unchecked="OnModeChanged" />
                    <CheckBox x:Name="ModeClone" Grid.Row="1" Grid.Column="1" Content="复制模式" Tag="clone"
                              Checked="OnModeChanged" Unchecked="OnModeChanged" />
                </Grid>

                <!-- 底部操作 -->
                <Button x:Name="RestoreDefaultsButton"
                        Content="恢复默认"
                        Click="OnRestoreDefaults"
                        HorizontalAlignment="Left"
                        Margin="0,28,0,0" />
                <InfoBar x:Name="StatusBar"
                         Severity="Informational"
                         IsOpen="False"
                         IsClosable="False"
                         Margin="0,12,0,0" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
