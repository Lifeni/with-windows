<Window
    x:Class="WithWindows.ToggleWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#FF2B2B30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 自绘标题栏 -->
        <Grid x:Name="TitleBarElement"
              Grid.Row="0"
              Height="44"
              Background="{ThemeResource LayerFillColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="16,0,0,0">
                <TextBlock Text="设置" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="12,12,12,20" Spacing="0" MaxWidth="460" HorizontalAlignment="Left">

                <!-- 快捷记事 -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,10">
                    <StackPanel Spacing="12">
                        <TextBlock Text="快捷记事" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Content="设置快捷键" Click="OnSetNotepadHotkey" />
                            <TextBlock x:Name="NotepadHotkeyText" Grid.Column="1" VerticalAlignment="Center" />
                            <Button Grid.Column="2"
                                    Background="Transparent" BorderThickness="0" Padding="6"
                                    ToolTipService.ToolTip="恢复默认快捷键 F13"
                                    Click="OnResetNotepadHotkey">
                                <FontIcon Glyph="&#xE777;" FontSize="14" />
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 切换投屏 -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,10">
                    <StackPanel Spacing="12">
                        <TextBlock Text="切换投屏" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Content="设置快捷键" Click="OnSetDisplayHotkey" />
                            <TextBlock x:Name="DisplayHotkeyText" Grid.Column="1" VerticalAlignment="Center" />
                            <Button Grid.Column="2"
                                    Background="Transparent" BorderThickness="0" Padding="6"
                                    ToolTipService.ToolTip="恢复默认快捷键 F14"
                                    Click="OnResetDisplayHotkey">
                                <FontIcon Glyph="&#xE777;" FontSize="14" />
                            </Button>
                        </Grid>
                        <TextBlock Text="切换模式（勾选参与循环切换的模式）"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Grid ColumnSpacing="12" RowSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <CheckBox x:Name="ModeInternal" Content="仅当前屏幕" Tag="internal"
                                      Checked="OnModeChanged" Unchecked="OnModeChanged" />
                            <CheckBox x:Name="ModeExtend" Grid.Column="1" Content="扩展模式" Tag="extend"
                                      Checked="OnModeChanged" Unchecked="OnModeChanged" />
                            <CheckBox x:Name="ModeExternal" Grid.Row="1" Content="仅外接屏幕" Tag="external"
                                      Checked="OnModeChanged" Unchecked="OnModeChanged" />
                            <CheckBox x:Name="ModeClone" Grid.Row="1" Grid.Column="1" Content="复制模式" Tag="clone"
                                      Checked="OnModeChanged" Unchecked="OnModeChanged" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 开机自启 -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,10">
                    <ToggleSwitch x:Name="AutoStartToggle"
                                  Header="开机自启"
                                  OnContent="开启"
                                  OffContent="关闭"
                                  Toggled="OnAutoStartToggled" />
                </Border>

                <!-- 关于 -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,0">
                    <StackPanel Spacing="2">
                        <TextBlock Text="With Windows" FontWeight="SemiBold" />
                        <TextBlock x:Name="AboutText" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <InfoBar x:Name="StatusBar"
                 Severity="Informational"
                 IsOpen="False"
                 IsClosable="False"
                 VerticalAlignment="Bottom"
                 Margin="12,0,12,12" />
    </Grid>
</Window>
