<Window
    x:Class="WithWindows.ToggleWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WithWindows.Controls"
    Title="一键切换">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="20" Spacing="16" MaxWidth="520" HorizontalAlignment="Left">

            <!-- 亮暗切换 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="切换亮暗" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="快捷键" VerticalAlignment="Center" />
                        <controls:HotkeyInputBox x:Name="ThemeHotkey" Grid.Column="1" />
                    </Grid>
                    <ToggleSwitch x:Name="AutoThemeToggle"
                                  Header="日出日落自动切换"
                                  OnContent="启用"
                                  OffContent="关闭"
                                  Toggled="OnAutoThemeToggled" />
                    <StackPanel x:Name="AutoThemeOptions" Spacing="8" Visibility="Collapsed">
                        <TextBlock Text="坐标与固定时间二选一（不填坐标时使用内置默认坐标）"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ThemeLatitude" Header="纬度" />
                            <TextBox x:Name="ThemeLongitude" Grid.Column="1" Header="经度" />
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ThemeSunrise" Header="固定日出（HH:mm）" />
                            <TextBox x:Name="ThemeSunset" Grid.Column="1" Header="固定日落（HH:mm）" />
                        </Grid>
                        <TextBox x:Name="ThemeOffset" Header="偏移分钟（正数 = 延后）" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 屏幕切换 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="切换屏幕" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="快捷键" VerticalAlignment="Center" />
                        <controls:HotkeyInputBox x:Name="DisplayHotkey" Grid.Column="1" />
                    </Grid>
                    <TextBlock Text="切换模式（勾选参与循环切换的模式）"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Grid ColumnSpacing="12" RowSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <CheckBox x:Name="ModeInternal" Content="仅当前屏幕" Tag="internal" />
                        <CheckBox x:Name="ModeExtend" Grid.Column="1" Content="扩展模式" Tag="extend" />
                        <CheckBox x:Name="ModeExternal" Grid.Row="1" Content="仅外接屏幕" Tag="external" />
                        <CheckBox x:Name="ModeClone" Grid.Row="1" Grid.Column="1" Content="复制模式" Tag="clone" />
                    </Grid>
                </StackPanel>
            </Border>

            <Button x:Name="SaveButton"
                    Content="保存并生效"
                    Click="OnSave"
                    Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Stretch" />
        </StackPanel>
    </ScrollViewer>
</Window>
