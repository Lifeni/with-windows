<Window
    x:Class="WithWindows.ToggleWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 自绘标题栏 -->
        <Grid x:Name="TitleBarElement"
              Grid.Row="0"
              Height="44"
              Background="{ThemeResource LayerFillColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="16,0,0,0">
                <TextBlock Text="设置" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="24,16,24,24" Spacing="0">

                <!-- 亮暗 -->
                <TextBlock Text="切换亮暗" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,12" />
                <Button x:Name="ThemeCard"
                        Height="76"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Padding="16,0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Click="OnToggleTheme">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE790;" FontSize="22" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="点击切换" FontWeight="SemiBold" />
                            <TextBlock x:Name="ThemeStatusText" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="14" VerticalAlignment="Center" />
                    </Grid>
                </Button>
                <Expander Header="更多选项" IsExpanded="False" HorizontalAlignment="Stretch" Margin="0,8,0,0">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="72" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="快捷键" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="ThemeHotkeyText" Grid.Column="1" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Content="设置快捷键" Click="OnSetThemeHotkey" />
                        </Grid>
                        <ToggleSwitch x:Name="AutoThemeToggle"
                                      Header="自动亮暗"
                                      OnContent="启用"
                                      OffContent="关闭"
                                      Toggled="OnAutoThemeToggled" />
                        <StackPanel x:Name="AutoThemeOptions" Spacing="8" Visibility="Collapsed">
                            <TextBlock Text="打开开关时自动按系统时区填入默认坐标；坐标与固定时间二选一"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ThemeLatitude" Header="纬度" TextChanged="OnAutoSaveTextChanged" />
                                <TextBox x:Name="ThemeLongitude" Grid.Column="1" Header="经度" TextChanged="OnAutoSaveTextChanged" />
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ThemeSunrise" Header="固定日出（HH:mm）" TextChanged="OnAutoSaveTextChanged" />
                                <TextBox x:Name="ThemeSunset" Grid.Column="1" Header="固定日落（HH:mm）" TextChanged="OnAutoSaveTextChanged" />
                            </Grid>
                            <TextBox x:Name="ThemeOffset" Header="偏移分钟（正数 = 延后）" TextChanged="OnAutoSaveTextChanged" />
                        </StackPanel>
                    </StackPanel>
                </Expander>

                <!-- 屏幕 -->
                <TextBlock Text="切换屏幕" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,28,0,12" />
                <Button x:Name="DisplayCard"
                        Height="76"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Padding="16,0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Click="OnToggleDisplay">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE7F4;" FontSize="22" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="点击切换" FontWeight="SemiBold" />
                            <TextBlock x:Name="DisplayStatusText" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="14" VerticalAlignment="Center" />
                    </Grid>
                </Button>
                <Expander Header="更多选项" IsExpanded="False" HorizontalAlignment="Stretch" Margin="0,8,0,0">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="72" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="快捷键" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="DisplayHotkeyText" Grid.Column="1" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Content="设置快捷键" Click="OnSetDisplayHotkey" />
                        </Grid>
                        <TextBlock Text="切换模式（勾选参与循环切换的模式）"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Grid ColumnSpacing="12" RowSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <CheckBox x:Name="ModeInternal" Content="仅当前屏幕" Tag="internal"
                                      Checked="OnModeChanged" Unchecked="OnModeChanged" />
                            <CheckBox x:Name="ModeExtend" Grid.Column="1" Content="扩展模式" Tag="extend"
                                      Checked="OnModeChanged" Unchecked="OnModeChanged" />
                            <CheckBox x:Name="ModeExternal" Grid.Row="1" Content="仅外接屏幕" Tag="external"
                                      Checked="OnModeChanged" Unchecked="OnModeChanged" />
                            <CheckBox x:Name="ModeClone" Grid.Row="1" Grid.Column="1" Content="复制模式" Tag="clone"
                                      Checked="OnModeChanged" Unchecked="OnModeChanged" />
                        </Grid>
                    </StackPanel>
                </Expander>

                <!-- 记事本 -->
                <TextBlock Text="记事本" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,28,0,12" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="72" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="快捷键" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="NotepadHotkeyText" Grid.Column="1" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Content="设置快捷键" Click="OnSetNotepadHotkey" />
                </Grid>

                <!-- 底部 -->
                <Button x:Name="RestoreDefaultsButton"
                        Content="恢复默认"
                        Click="OnRestoreDefaults"
                        HorizontalAlignment="Left"
                        Margin="0,28,0,0" />
                <InfoBar x:Name="StatusBar"
                         Severity="Informational"
                         IsOpen="False"
                         IsClosable="False"
                         Margin="0,12,0,0" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
