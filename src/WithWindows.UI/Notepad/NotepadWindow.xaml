<Window
    x:Class="WithWindows.Notepad.NotepadWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏兼工具栏：左（剪贴板 / 复制 / 另存为 / AI 回复）右（进度，避让系统按钮） -->
        <Grid x:Name="TitleBarElement"
              Grid.Row="0"
              Height="44"
              Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="4,0,0,0">
                <Button x:Name="ClipboardButton"
                        Click="OnClipboardPaste"
                        Padding="10,6"
                        ToolTipService.ToolTip="粘贴剪贴板内容">
                    <FontIcon Glyph="&#xE16F;" FontSize="14" />
                </Button>
                <Button x:Name="CopyButton"
                        Click="OnCopyAll"
                        Padding="10,6"
                        ToolTipService.ToolTip="复制全部内容">
                    <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                </Button>
                <Button x:Name="SaveAsButton"
                        Click="OnSaveAs"
                        Padding="10,6"
                        ToolTipService.ToolTip="另存为">
                    <FontIcon Glyph="&#xE74E;" FontSize="14" />
                </Button>
                <ToggleButton x:Name="AiPanelButton"
                              Padding="10,6"
                              ToolTipService.ToolTip="AI 助手"
                              Checked="OnAiPanelToggle"
                              Unchecked="OnAiPanelToggle">
                    <FontIcon Glyph="&#xE8F2;" FontSize="14" />
                </ToggleButton>
            </StackPanel>
            <!-- 右侧避让系统标题栏按钮（最小化/最大化/关闭 约 138px） -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Center" Margin="0,0,146,0">
                <ProgressRing x:Name="AiProgress" IsActive="False" Width="20" Height="20" />
            </StackPanel>
        </Grid>

        <!-- 内容区：AI 侧栏（左）+ 编辑器（右） -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="AiColumn" Width="0" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- AI 侧栏：默认隐藏；打开即自动提问，未配置则弹设置 -->
            <Grid x:Name="AiSidePanel" Grid.Column="0" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,0,1,0"
                        Padding="12,8">
                    <TextBlock Text="AI 回复" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center"
                            Spacing="8" Padding="0,8">
                    <Button x:Name="AskAiButton" Content="问 AI" Click="OnAskAi" />
                    <Button x:Name="AiConfigButton" Content="AI 设置" Click="OnOpenAiConfig" />
                </StackPanel>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="AiReply"
                               TextWrapping="Wrap"
                               IsTextSelectionEnabled="True"
                               Padding="12,8,12,8" />
                </ScrollViewer>
            </Grid>

            <TextBox x:Name="Editor"
                     Grid.Column="1"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     FontFamily="Consolas"
                     FontSize="14"
                     Padding="12"
                     VerticalAlignment="Stretch"
                     TextChanged="OnTextChanged"
                     SelectionChanged="OnSelectionChanged" />
        </Grid>

        <!-- 状态栏：行列与字符数 -->
        <Border Grid.Row="2"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                Padding="12,5">
            <TextBlock x:Name="StatusText"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Border>
    </Grid>
</Window>
