<Window
    x:Class="WithWindows.Notepad.NotepadWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 自绘标题栏：随主题背景 + 系统按钮透明 -->
        <Grid x:Name="TitleBarElement"
              Grid.Row="0"
              Height="44"
              Background="{ThemeResource LayerFillColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="16,0,0,0">
                <Image Source="Assets/with-windows.png" Width="14" Height="14" />
                <TextBlock x:Name="TitleText" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- 工具栏：操作按钮左右分布（剪贴板 / 问 AI / 设置 | 进度 / 清除回复） -->
        <Grid Grid.Row="1" Padding="12,8" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="ClipboardButton"
                        Click="OnClipboardPaste"
                        ToolTipService.ToolTip="粘贴剪贴板内容">
                    <FontIcon Glyph="&#xE16F;" FontSize="14" />
                </Button>
                <Button x:Name="AskAiButton"
                        Click="OnAskAi"
                        ToolTipService.ToolTip="问 AI">
                    <FontIcon Glyph="&#xE724;" FontSize="14" />
                </Button>
                <Button x:Name="AiConfigButton"
                        Click="OnOpenAiConfig"
                        ToolTipService.ToolTip="AI 设置">
                    <FontIcon Glyph="&#xE713;" FontSize="14" />
                </Button>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <ProgressRing x:Name="AiProgress" IsActive="False" Width="20" Height="20" />
                <Button x:Name="ClearAiButton" Content="清除回复" Click="OnClearAi" />
            </StackPanel>
        </Grid>

        <!-- 编辑器 -->
        <TextBox x:Name="Editor"
                 Grid.Row="2"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 FontFamily="Consolas"
                 FontSize="14"
                 Padding="12"
                 VerticalAlignment="Stretch"
                 TextChanged="OnTextChanged" />

        <!-- AI 助手：可折叠回复区 -->
        <Expander x:Name="AiPanel"
                  Grid.Row="3"
                  Header="AI 助手"
                  IsExpanded="False">
            <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="AiReply"
                           TextWrapping="Wrap"
                           IsTextSelectionEnabled="True"
                           Padding="8" />
            </ScrollViewer>
        </Expander>
    </Grid>
</Window>
