<Window
    x:Class="WithWindows.Notepad.NotepadWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#FF2B2B30">
        <Grid.Resources>
            <!-- 无边框无聚焦下划线（RichEditBox 默认模板聚焦时显示主题色下划线） -->
            <Style x:Key="PlainRichEditStyle" TargetType="RichEditBox">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RichEditBox">
                            <ScrollViewer x:Name="ContentElement"
                                          Margin="0"
                                          Padding="{TemplateBinding Padding}"
                                          IsTabStop="False"
                                          ZoomMode="Disabled" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏兼工具栏：左（设置）右（避让系统按钮） -->
        <Grid x:Name="TitleBarElement"
              Grid.Row="0"
              Height="44"
              Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TitleTimeText"
                       FontSize="18"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0" />
            <!-- 右侧避让系统标题栏按钮（约 138px） -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Center" Margin="0,0,146,0" />
        </Grid>

        <!-- 编辑器（Ctrl+C/V 原生复制粘贴，Ctrl+S 另存为；RichEditBox 支持行距） -->
        <RichEditBox x:Name="Editor"
                     Grid.Row="1"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     FontFamily="Consolas"
                     FontSize="14"
                     BorderThickness="0"
                     Padding="12"
                     VerticalAlignment="Stretch"
                     Style="{StaticResource PlainRichEditStyle}"
                     TextChanged="OnTextChanged"
                     SelectionChanged="OnSelectionChanged"
                     KeyDown="OnEditorKeyDown" />

        <!-- 状态栏：行列与字符数 + 置顶开关（高度预留边框，按钮右下边距一致） -->
        <Border Grid.Row="2"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                Padding="12,4">
            <Grid>
                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ToggleButton x:Name="PinButton"
                              Width="22"
                              Height="22"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              Padding="0"
                              Margin="0,0,-6,0"
                              ToolTipService.ToolTip="置顶"
                              Checked="OnPinToggle"
                              Unchecked="OnPinToggle">
                    <FontIcon x:Name="PinIcon" Glyph="&#xE718;" FontSize="10" />
                </ToggleButton>
            </Grid>
        </Border>
    </Grid>
</Window>
