<Window
    x:Class="WithWindows.Notepad.NotepadWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.Resources>
            <!-- 无边框无聚焦下划线的编辑器模板（默认模板聚焦时显示主题色下划线） -->
            <Style x:Key="PlainEditorStyle" TargetType="TextBox">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <ScrollViewer x:Name="ContentElement"
                                          Margin="0"
                                          Padding="{TemplateBinding Padding}"
                                          IsTabStop="False"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto"
                                          ZoomMode="Disabled" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏兼工具栏：左（设置）右（避让系统按钮） -->
        <Grid x:Name="TitleBarElement"
              Grid.Row="0"
              Height="44"
              Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="4,0,0,0">
                <Button x:Name="SettingsButton"
                        Click="OnOpenSettings"
                        Padding="10,6"
                        ToolTipService.ToolTip="设置">
                    <FontIcon Glyph="&#xE713;" FontSize="14" />
                </Button>
            </StackPanel>
            <!-- 右侧避让系统标题栏按钮（约 138px） -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Center" Margin="0,0,146,0" />
        </Grid>

        <!-- 编辑器（Ctrl+C/V 原生复制粘贴，Ctrl+S 另存为） -->
        <TextBox x:Name="Editor"
                 Grid.Row="1"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 FontFamily="Consolas"
                 FontSize="14"
                 BorderThickness="0"
                 Padding="12"
                 VerticalAlignment="Stretch"
                 Style="{StaticResource PlainEditorStyle}"
                 TextChanged="OnTextChanged"
                 SelectionChanged="OnSelectionChanged"
                 KeyDown="OnEditorKeyDown" />

        <!-- 状态栏：行列与字符数 -->
        <Border Grid.Row="2"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                Padding="12,5">
            <TextBlock x:Name="StatusText"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Border>
    </Grid>
</Window>
