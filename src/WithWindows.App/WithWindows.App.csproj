<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22621.0</TargetPlatformMinVersion>
    <RootNamespace>WithWindows</RootNamespace>
    <AssemblyName>WithWindows</AssemblyName>
    <!-- 把应用图标嵌进 exe（资源管理器里可见）。注意：运行期图标仍从 Assets\with-windows.ico 读取，
         没有运行时兜底，所以安装包与便携包都必须带上 Assets -->
    <ApplicationIcon>Assets\with-windows.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <!-- 未打包：不使用 MSIX，无包身份 -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- 只保留中文与英文的 .NET 卫星资源；WinUI 原生 .mui 由下面的发布过滤处理 -->
    <SatelliteResourceLanguages>en;en-US;zh-CN;zh-TW</SatelliteResourceLanguages>
    <PublishSingleFile>false</PublishSingleFile>
    <!-- 单文件发布时 WASDK 强制要求开启 MSIX 工具链（已知坑） -->
    <EnableMsixTooling Condition="'$(PublishSingleFile)' == 'true'">true</EnableMsixTooling>
    <EnableMsixTooling Condition="'$(PublishSingleFile)' != 'true'">false</EnableMsixTooling>
    <Version>0.6.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- 按组件引用：WinUI / Foundation / InteractiveExperiences / DWrite / Runtime -->
    <PackageReference Include="Microsoft.WindowsAppSDK.Base" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" />
    <PackageReference Include="Microsoft.WindowsAppSDK.DWrite" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="WinUIEx" />
    <PackageReference Include="Markdig" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WithWindows.Core\WithWindows.Core.csproj" />
  </ItemGroup>

  <!-- 把构建日期写进程序集，供「关于」里显示 -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BuildDate</_Parameter1>
      <_Parameter2>$([System.DateTime]::Now.ToString("yyyy-MM-dd"))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- CopyToPublishDirectory 必须显式设置：单文件发布时 Content 不会被复制到 publish 目录，
         缺了 Assets 会导致托盘图标与窗口图标丢失 -->
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!--
      Windows App SDK 2.5.1 的自包含应用缺少该 Insights 资源 DLL，
      AppNotificationManager.Register() 会因 0x8007007E 失败。
      文件取自同一 WindowsAppSDK.Runtime 包的 Framework MSIX，等官方稳定版修复后可移除。
    -->
    <None
      Include="Runtime\Microsoft.WindowsAppRuntime.Insights.Resource.dll"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest">
      <TargetPath>Microsoft.WindowsAppRuntime.Insights.Resource.dll</TargetPath>
    </None>
  </ItemGroup>

  <!-- WindowsAppSDK 的应用内容在 publish 阶段不会随单文件一起复制（已知坑，与旧项目的 XBF/PRI 同类）。
       仅靠上面的 CopyToPublishDirectory 不生效，这里显式补齐，否则安装后托盘与窗口图标会丢失。 -->
  <Target Name="CopyAssetsToPublish" AfterTargets="Publish">
    <ItemGroup>
      <AssetsToPublish Include="Assets\**" />
    </ItemGroup>
    <Copy
      SourceFiles="@(AssetsToPublish)"
      DestinationFolder="$(PublishDir)Assets\%(RecursiveDir)"
      SkipUnchangedFiles="true" />
  </Target>

  <!--
    WinUI / WindowsAppSDK 自带 80 多种语言的 .mui 资源（每种语言两个文件，合计约 3.4 MB）。
    发布前从 ResolvedFileToPublish 移除不在白名单里的语言目录；只保留中文与英文，
    非白名单语言会回退到英文资源。
  -->
  <Target Name="RemoveUnwantedLocaleResources"
          BeforeTargets="_ComputeFilesToBundle">
    <ItemGroup>
      <ResolvedFileToPublish
        Remove="@(ResolvedFileToPublish)"
        Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(RelativePath)', '^[a-z]{2}(-[A-Za-z0-9]+)+[\\/]')) AND $([System.Text.RegularExpressions.Regex]::IsMatch('%(RelativePath)', '^(?i)(en(-|[\\/])|zh-(CN|TW|HK|Hans|Hant)([\\/]|$))')) == 'False'" />
    </ItemGroup>
  </Target>
</Project>
