<Page
    x:Class="WithWindows.Views.TodoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WithWindows.Views">

    <Page.Resources>
        <DataTemplate x:Key="TodoRowTemplate" x:DataType="local:TodoRowViewModel">
            <Border
                Margin="0,0,0,8"
                Padding="14,12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox
                        MinWidth="0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        AutomationProperties.AutomationId="{x:Bind CompleteAutomationId}"
                        AutomationProperties.Name="完成待办"
                        Click="OnCompletedClick"
                        IsChecked="{x:Bind IsCompleted}"
                        Tag="{x:Bind Id}">
                    </CheckBox>

                    <StackPanel
                        Grid.Column="1"
                        MinWidth="0"
                        Spacing="3"
                        VerticalAlignment="Center">
                        <TextBlock
                            FontSize="15"
                            Text="{x:Bind Title}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap"
                            Visibility="{x:Bind PendingVisibility}" />
                        <TextBlock
                            FontSize="15"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind Title}"
                            TextDecorations="Strikethrough"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap"
                            Visibility="{x:Bind CompletedVisibility}" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ReminderText}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="2"
                        VerticalAlignment="Center">
                        <Button
                            Width="36"
                            Height="36"
                            Padding="0"
                            AutomationProperties.AutomationId="{x:Bind ReminderAutomationId}"
                            AutomationProperties.Name="{x:Bind ReminderButtonText}"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnReminderClick"
                            Tag="{x:Bind Id}"
                            ToolTipService.ToolTip="{x:Bind ReminderButtonText}"
                            Visibility="{x:Bind PendingVisibility}">
                            <FontIcon FontSize="16" Glyph="&#xEA8F;" />
                        </Button>
                        <Button
                            Width="36"
                            Height="36"
                            Padding="0"
                            AutomationProperties.AutomationId="{x:Bind DeleteAutomationId}"
                            AutomationProperties.Name="删除待办"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnDeleteClick"
                            Tag="{x:Bind Id}"
                            ToolTipService.ToolTip="删除待办">
                            <FontIcon FontSize="16" Glyph="&#xE74D;" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel
            MaxWidth="900"
            HorizontalAlignment="Stretch"
            Spacing="14">
            <StackPanel Spacing="4">
                <TextBlock
                    AutomationProperties.AutomationId="TodoTitle"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="待办" />
                <TextBlock
                    x:Name="SummaryText"
                    AutomationProperties.AutomationId="TodoSummary"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="暂无待办" />
            </StackPanel>

            <Border
                Padding="6,4,4,4"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox
                        x:Name="NewTodoInput"
                        MinHeight="42"
                        Padding="10,8"
                        AutomationProperties.AutomationId="TodoNewInput"
                        AutomationProperties.Name="待办标题"
                        Background="Transparent"
                        BorderThickness="0"
                        KeyDown="OnNewInputKeyDown"
                        PlaceholderText="添加待办，按 Enter 保存" />

                    <Button
                        Grid.Column="1"
                        MinWidth="84"
                        AutomationProperties.AutomationId="TodoAddButton"
                        AutomationProperties.Name="添加待办"
                        Click="OnAddClick"
                        Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="14" Glyph="&#xE710;" />
                            <TextBlock Text="添加" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <InfoBar
                x:Name="TodoReminderBar"
                AutomationProperties.AutomationId="TodoReminderBar"
                IsClosable="True"
                IsOpen="False"
                Severity="Informational"
                Title="待办提醒" />
        </StackPanel>

        <Grid
            Grid.Row="1"
            MaxWidth="900"
            Margin="0,16,0,0"
            HorizontalAlignment="Stretch">
            <ListView
                x:Name="TodoList"
                AutomationProperties.AutomationId="TodoList"
                HorizontalContentAlignment="Stretch"
                ItemTemplate="{StaticResource TodoRowTemplate}"
                ItemsSource="{x:Bind Items}"
                SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="IsTabStop" Value="False" />
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>

            <StackPanel
                x:Name="EmptyState"
                MaxWidth="360"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="10">
                <FontIcon
                    HorizontalAlignment="Center"
                    FontSize="42"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE9D5;" />
                <TextBlock
                    AutomationProperties.AutomationId="TodoEmptyState"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="还没有待办"
                    TextAlignment="Center" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="从上方添加第一项；每项都可以设置独立提醒。"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>

            <InfoBar
                x:Name="TodoErrorBar"
                Margin="0,8,0,8"
                VerticalAlignment="Bottom"
                AutomationProperties.AutomationId="TodoErrorBar"
                IsClosable="True"
                IsOpen="False"
                Severity="Error" />
        </Grid>
    </Grid>
</Page>
