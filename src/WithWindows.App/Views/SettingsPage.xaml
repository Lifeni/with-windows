<Page
    x:Class="WithWindows.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WithWindows.Controls">

    <ScrollViewer Padding="24">
        <!-- 与 PowerToys 一致：内容铺开到可用宽度，上限 1200 DIP 并水平居中 -->
        <Grid x:Name="ContentHost">
            <StackPanel
                Width="{Binding ActualWidth, ElementName=ContentHost}"
                MaxWidth="1200"
                HorizontalAlignment="Center"
                Spacing="8">
            <TextBlock
                Margin="0,0,0,8"
                AutomationProperties.AutomationId="SettingsPlaceholder"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="设置" />

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="启动" />
            <controls:CardRow
                AutomationProperties.AutomationId="AutoStartCard"
                Description="登录 Windows 后自动启动并常驻托盘"
                Glyph="&#xE7E8;"
                Title="开机自启">
                <controls:CardRow.Trailing>
                    <!-- 状态文字放左侧、开关贴右边缘（对齐 PowerToys 卡片行） -->
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock
                            x:Name="AutoStartStateText"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="关" />
                        <ToggleSwitch
                            x:Name="AutoStartToggle"
                            AutomationProperties.AutomationId="AutoStartToggle"
                            MinWidth="0"
                            OffContent=""
                            OnContent=""
                            Toggled="OnAutoStartToggled" />
                    </StackPanel>
                </controls:CardRow.Trailing>
            </controls:CardRow>

            <!-- 呼出主窗口：全局热键，把隐藏到托盘的主窗口叫回来（打开记事页） -->
            <controls:HotkeyRow
                x:Name="ShowWindowRow"
                Description="按下组合键从托盘唤出主窗口并打开记事"
                Glyph="&#xE765;"
                Title="呼出主窗口"
                ToolId="notepad" />

            <TextBlock Margin="0,8,0,0" Style="{StaticResource SubtitleTextBlockStyle}" Text="关于" />
            <Border
                Padding="16,12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Image
                        x:Name="AboutIconImage"
                        Grid.Column="0"
                        Width="48"
                        Height="48"
                        VerticalAlignment="Top"
                        AutomationProperties.AutomationId="AboutIcon" />

                    <StackPanel Grid.Column="1" Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock
                                x:Name="VersionText"
                                AutomationProperties.AutomationId="AboutVersion"
                                Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                x:Name="BuildDateText"
                                AutomationProperties.AutomationId="AboutBuildDate"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <HyperlinkButton
                                AutomationProperties.AutomationId="AboutRepository"
                                Click="OnOpenRepositoryClick">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="14" Glyph="&#xE774;" />
                                    <TextBlock Text="GitHub 仓库" />
                                </StackPanel>
                            </HyperlinkButton>
                            <Button
                                AutomationProperties.AutomationId="OpenConfigFolder"
                                Click="OnOpenConfigFolderClick"
                                Content="打开配置目录" />
                            <Button
                                AutomationProperties.AutomationId="OpenLogFile"
                                Click="OnOpenLogFileClick"
                                Content="打开日志文件" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
