<Page
    x:Class="WithWindows.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WithWindows.Controls">

    <ScrollViewer
        x:Name="PageScroll"
        Padding="24"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled">
        <!-- 与 PowerToys 一致：内容跟随视口宽度，上限 1200 DIP 并水平居中 -->
        <StackPanel
            Width="{Binding ViewportWidth, ElementName=PageScroll}"
            MaxWidth="1200"
            HorizontalAlignment="Center"
            Spacing="8">
            <TextBlock
                Margin="0,0,0,8"
                AutomationProperties.AutomationId="SettingsPlaceholder"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="设置" />

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="启动" />
            <controls:CardRow
                AutomationProperties.AutomationId="AutoStartCard"
                Description="登录 Windows 后自动启动并常驻托盘"
                Glyph="&#xE7E8;"
                Title="开机自启">
                <controls:CardRow.Trailing>
                    <!-- 状态文字放左侧、开关贴右边缘（对齐 PowerToys 卡片行） -->
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock
                            x:Name="AutoStartStateText"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="关" />
                        <ToggleSwitch
                            x:Name="AutoStartToggle"
                            AutomationProperties.AutomationId="AutoStartToggle"
                            MinWidth="0"
                            OffContent=""
                            OnContent=""
                            Toggled="OnAutoStartToggled" />
                    </StackPanel>
                </controls:CardRow.Trailing>
            </controls:CardRow>

            <!-- 呼出主窗口：全局热键，把隐藏到托盘的主窗口叫回来（打开记事页） -->
            <controls:HotkeyRow
                x:Name="ShowWindowRow"
                Description="按下组合键从托盘唤出主窗口并打开记事"
                Glyph="&#xE765;"
                Title="呼出主窗口"
                ToolId="notepad" />

            <!-- 关于：参考 WinUI Gallery 的写法——折叠成一项，展开后每个条目一行 -->
            <Expander
                Margin="0,8,0,0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                AutomationProperties.AutomationId="AboutExpander"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6"
                IsExpanded="False">
                <Expander.Header>
                    <Grid Padding="16,12" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Image
                            x:Name="AboutIconImage"
                            Grid.Column="0"
                            Width="32"
                            Height="32"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="AboutIcon" />

                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="关于" />
                            <TextBlock
                                x:Name="AboutSummaryText"
                                AutomationProperties.AutomationId="AboutSummary"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                    </Grid>
                </Expander.Header>

                <StackPanel Margin="16,4,16,12" Spacing="12">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="版本" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            x:Name="VersionText"
                            Grid.Column="1"
                            AutomationProperties.AutomationId="AboutVersion" />
                    </Grid>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="构建日期" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            x:Name="BuildDateText"
                            Grid.Column="1"
                            AutomationProperties.AutomationId="AboutBuildDate" />
                    </Grid>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="GitHub 仓库" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <HyperlinkButton
                            Grid.Column="1"
                            Padding="0"
                            AutomationProperties.AutomationId="AboutRepository"
                            Click="OnOpenRepositoryClick"
                            Content="github.com/Lifeni/with-windows" />
                    </Grid>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="配置目录" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button
                            Grid.Column="1"
                            HorizontalAlignment="Left"
                            AutomationProperties.AutomationId="OpenConfigFolder"
                            Click="OnOpenConfigFolderClick"
                            Content="打开配置目录" />
                    </Grid>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="日志文件" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button
                            Grid.Column="1"
                            HorizontalAlignment="Left"
                            AutomationProperties.AutomationId="OpenLogFile"
                            Click="OnOpenLogFileClick"
                            Content="打开日志文件" />
                    </Grid>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</Page>
