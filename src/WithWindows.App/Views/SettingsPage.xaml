<Page
    x:Class="WithWindows.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WithWindows.Controls">

    <ScrollViewer
        x:Name="PageScroll"
        Padding="24"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled">
        <!-- 与 PowerToys 一致：内容跟随视口宽度，上限 1200 DIP 并水平居中 -->
        <StackPanel
            Width="{Binding ViewportWidth, ElementName=PageScroll}"
            MaxWidth="1200"
            HorizontalAlignment="Center"
            Spacing="8">
            <TextBlock
                Margin="0,0,0,8"
                AutomationProperties.AutomationId="SettingsPlaceholder"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="设置" />

            <controls:CardRow
                AutomationProperties.AutomationId="AutoStartCard"
                Glyph="&#xE7E8;"
                Title="开机自启">
                <controls:CardRow.Trailing>
                    <!-- 状态文字放左侧、开关贴右边缘（对齐 PowerToys 卡片行） -->
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock
                            x:Name="AutoStartStateText"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="关" />
                        <ToggleSwitch
                            x:Name="AutoStartToggle"
                            AutomationProperties.AutomationId="AutoStartToggle"
                            MinWidth="0"
                            OffContent=""
                            OnContent=""
                            Toggled="OnAutoStartToggled" />
                    </StackPanel>
                </controls:CardRow.Trailing>
            </controls:CardRow>

            <!-- 显示 / 隐藏窗口：从隐藏状态唤出时打开下方配置的默认页面；已在屏幕上时再按收起 -->
            <StackPanel Spacing="0">
                <controls:HotkeyRow
                    x:Name="ShowWindowRow"
                    CardBorderThickness="1,1,1,0"
                    CardCornerRadius="6,6,0,0"
                    Glyph="&#xE765;"
                    Title="显示 / 隐藏窗口"
                    ToolId="notepad" />

                <controls:CardRow
                    AutomationProperties.AutomationId="DefaultWindowPageCard"
                    CardCornerRadius="0,0,6,6"
                    Glyph="&#xE8A7;"
                    Title="默认打开窗口">
                    <controls:CardRow.Trailing>
                        <ComboBox
                            x:Name="DefaultWindowPageComboBox"
                            Width="160"
                            AutomationProperties.AutomationId="DefaultWindowPageComboBox"
                            AutomationProperties.Name="默认打开窗口"
                            SelectionChanged="OnDefaultWindowPageChanged">
                            <ComboBoxItem Content="记事" Tag="notepad" />
                            <ComboBoxItem Content="待办" Tag="todo" />
                            <ComboBoxItem Content="AI 对话" Tag="ai_chat" />
                        </ComboBox>
                    </controls:CardRow.Trailing>
                </controls:CardRow>
            </StackPanel>

            <!-- 关于：参考 WinUI Gallery 的写法——折叠成一项，展开后每个条目一行 -->
            <Expander
                Margin="0,8,0,0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                AutomationProperties.AutomationId="AboutExpander"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6"
                IsExpanded="True">
                <Expander.Header>
                    <!--
                        水平内边距必须给 0：展开组件的头部本身会先留 16 DIP，再叠一层 16
                        就比上面卡片行的图标整整右移一格（实测卡片图标 x=139、关于图标 x=170）。
                    -->
                    <Grid
                        MinHeight="{StaticResource SettingCardMinHeight}"
                        Padding="0,12"
                        ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--
                            用字体图标而不是应用图标 PNG：PNG 是 256 的方图，中间的闪电只占一小块，
                            20 DIP 显示时实际墨迹只有约 9×16 DIP，和别的图标摆一起又小又偏；
                            E945 就是同一枚闪电的字体字形，尺寸与位置与其它图标完全一致。
                        -->
                        <FontIcon
                            Grid.Column="0"
                            AutomationProperties.AutomationId="AboutIcon"
                            FontSize="20"
                            Glyph="&#xE945;"
                            VerticalAlignment="Center" />

                        <!-- 必须显式居中：Grid 的子元素默认 Stretch，只有一行文字时会贴在行顶部 -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="关于">
                                <!-- 与卡片行标题同样的像素级微调（中文字形在行盒里天生偏低） -->
                                <TextBlock.RenderTransform>
                                    <TranslateTransform Y="-2" />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Expander.Header>

                <StackPanel Margin="16,4,16,12" Spacing="12">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="版本" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            x:Name="VersionText"
                            Grid.Column="1"
                            AutomationProperties.AutomationId="AboutVersion" />
                    </Grid>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="构建日期" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            x:Name="BuildDateText"
                            Grid.Column="1"
                            AutomationProperties.AutomationId="AboutBuildDate" />
                    </Grid>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="GitHub 仓库" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <HyperlinkButton
                            Grid.Column="1"
                            Padding="0"
                            AutomationProperties.AutomationId="AboutRepository"
                            Click="OnOpenRepositoryClick"
                            Content="github.com/Lifeni/with-windows" />
                    </Grid>

                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</Page>
