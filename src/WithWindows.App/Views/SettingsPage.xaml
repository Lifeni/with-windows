<Page
    x:Class="WithWindows.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16">
            <TextBlock
                AutomationProperties.AutomationId="SettingsPlaceholder"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="设置" />

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="启动" />
            <ToggleSwitch
                x:Name="AutoStartToggle"
                AutomationProperties.AutomationId="AutoStartToggle"
                Header="开机自启"
                OffContent="已关闭"
                OnContent="已开启"
                Toggled="OnAutoStartToggled" />

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="投屏候选模式" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="「切换投屏」在这些模式之间循环；至少保留一项。"
                TextWrapping="Wrap" />
            <StackPanel x:Name="ModesHost" Spacing="4" />

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="关于" />
            <StackPanel Spacing="8">
                <TextBlock x:Name="VersionText" AutomationProperties.AutomationId="AboutVersion" />
                <TextBox
                    x:Name="ConfigPathBox"
                    AutomationProperties.AutomationId="AboutConfigPath"
                    Header="配置路径"
                    IsReadOnly="True" />
                <TextBox
                    x:Name="LogPathBox"
                    AutomationProperties.AutomationId="AboutLogPath"
                    Header="日志路径"
                    IsReadOnly="True" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
