<Page
    x:Class="WithWindows.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WithWindows.Controls">

    <ScrollViewer Padding="24">
        <!-- 内容区限制最大宽度：参考系统记事本设置页，不要让文本横向铺满整个窗口 -->
        <StackPanel
            MaxWidth="760"
            HorizontalAlignment="Left"
            Spacing="8">
            <TextBlock
                Margin="0,0,0,8"
                AutomationProperties.AutomationId="SettingsPlaceholder"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="设置" />

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="启动" />
            <controls:CardRow
                AutomationProperties.AutomationId="AutoStartCard"
                Description="登录 Windows 后自动启动并常驻托盘"
                Glyph="&#xE7E8;"
                Title="开机自启">
                <controls:CardRow.Trailing>
                    <ToggleSwitch
                        x:Name="AutoStartToggle"
                        AutomationProperties.AutomationId="AutoStartToggle"
                        OffContent="关"
                        OnContent="开"
                        Toggled="OnAutoStartToggled" />
                </controls:CardRow.Trailing>
            </controls:CardRow>

            <!-- 呼出主窗口：全局热键，把隐藏到托盘的主窗口叫回来（打开记事页） -->
            <TextBlock Margin="0,8,0,0" Style="{StaticResource SubtitleTextBlockStyle}" Text="快捷键" />
            <controls:HotkeyRow
                x:Name="ShowWindowRow"
                Description="按下组合键从托盘唤出主窗口并打开记事"
                Glyph="&#xE765;"
                RunButtonText="打开主窗口"
                Title="呼出主窗口"
                ToolId="notepad" />

            <TextBlock Margin="0,8,0,0" Style="{StaticResource SubtitleTextBlockStyle}" Text="关于" />
            <Border
                Padding="16,12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            VerticalAlignment="Center"
                            FontSize="20"
                            Glyph="&#xE946;" />
                        <TextBlock
                            x:Name="VersionText"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="AboutVersion"
                            Style="{StaticResource BodyStrongTextBlockStyle}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            AutomationProperties.AutomationId="OpenConfigFolder"
                            Click="OnOpenConfigFolderClick"
                            Content="打开配置目录" />
                        <Button
                            AutomationProperties.AutomationId="OpenLogFile"
                            Click="OnOpenLogFileClick"
                            Content="打开日志文件" />
                    </StackPanel>

                    <TextBlock
                        x:Name="PathsText"
                        AutomationProperties.AutomationId="AboutPaths"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
