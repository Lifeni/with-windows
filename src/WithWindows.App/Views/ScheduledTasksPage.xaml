<Page
    x:Class="WithWindows.Views.ScheduledTasksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WithWindows.Views">

    <Page.Resources>
        <DataTemplate x:Key="TaskRowTemplate" x:DataType="local:ScheduledTaskRowViewModel">
            <Border
                Margin="0,0,0,8"
                Padding="14,12"
                AutomationProperties.AutomationId="{x:Bind AutomationId}"
                AutomationProperties.Name="{x:Bind Title}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon
                        FontSize="20"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE943;"
                        VerticalAlignment="Center" />

                    <StackPanel
                        Grid.Column="1"
                        MinWidth="0"
                        Spacing="3"
                        VerticalAlignment="Center">
                        <TextBlock
                            FontSize="15"
                            FontWeight="SemiBold"
                            Text="{x:Bind Title}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ScheduleText}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind DetailText}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="2"
                        VerticalAlignment="Center">
                        <Button
                            Width="36"
                            Height="36"
                            Padding="0"
                            AutomationProperties.AutomationId="{x:Bind RunAutomationId}"
                            AutomationProperties.Name="运行脚本"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnRunClick"
                            Tag="{x:Bind Id}"
                            ToolTipService.ToolTip="运行脚本"
                            Visibility="{x:Bind RunVisibility}">
                            <FontIcon FontSize="16" Glyph="&#xE768;" />
                        </Button>
                        <Button
                            Width="36"
                            Height="36"
                            Padding="0"
                            AutomationProperties.AutomationId="{x:Bind StopAutomationId}"
                            AutomationProperties.Name="停止脚本"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnStopClick"
                            Tag="{x:Bind Id}"
                            ToolTipService.ToolTip="停止脚本"
                            Visibility="{x:Bind StopVisibility}">
                            <FontIcon FontSize="16" Glyph="&#xE71A;" />
                        </Button>
                        <Button
                            Width="36"
                            Height="36"
                            Padding="0"
                            AutomationProperties.AutomationId="{x:Bind HistoryAutomationId}"
                            AutomationProperties.Name="查看运行日志"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnHistoryClick"
                            Tag="{x:Bind Id}"
                            ToolTipService.ToolTip="查看运行日志">
                            <FontIcon FontSize="16" Glyph="&#xE81C;" />
                        </Button>
                        <Button
                            Width="36"
                            Height="36"
                            Padding="0"
                            AutomationProperties.AutomationId="{x:Bind EditAutomationId}"
                            AutomationProperties.Name="编辑脚本"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnEditClick"
                            IsEnabled="{x:Bind EditDeleteEnabled}"
                            Tag="{x:Bind Id}"
                            ToolTipService.ToolTip="编辑脚本">
                            <FontIcon FontSize="16" Glyph="&#xE70F;" />
                        </Button>
                        <Button
                            Width="36"
                            Height="36"
                            Padding="0"
                            AutomationProperties.AutomationId="{x:Bind DeleteAutomationId}"
                            AutomationProperties.Name="删除脚本"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnDeleteClick"
                            IsEnabled="{x:Bind EditDeleteEnabled}"
                            Tag="{x:Bind Id}"
                            ToolTipService.ToolTip="删除脚本">
                            <FontIcon FontSize="16" Glyph="&#xE74D;" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            Grid.Row="0"
            MinHeight="48"
            Padding="16,8"
            ColumnSpacing="16"
            Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                x:Name="SummaryText"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="ScheduledTaskSummary"
                FontSize="14"
                FontWeight="SemiBold"
                Text="0 个脚本"
                TextTrimming="CharacterEllipsis" />

            <Button
                Grid.Column="1"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="ScheduledTaskNewButton"
                AutomationProperties.Name="添加脚本"
                Click="OnAddScriptClick">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE710;" />
                    <TextBlock Text="添加脚本" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid
            Grid.Row="1"
            MaxWidth="{StaticResource PageContentMaxWidth}"
            Margin="16,12,16,16"
            HorizontalAlignment="Stretch">
            <ListView
                x:Name="TaskList"
                AutomationProperties.AutomationId="ScheduledTaskList"
                AutomationProperties.Name="脚本列表"
                ContainerContentChanging="OnTaskContainerContentChanging"
                HorizontalContentAlignment="Stretch"
                ItemTemplate="{StaticResource TaskRowTemplate}"
                ItemsSource="{x:Bind Tasks}"
                SelectionMode="None">
                <ListView.ItemContainerTransitions>
                    <TransitionCollection>
                        <AddDeleteThemeTransition />
                        <RepositionThemeTransition />
                    </TransitionCollection>
                </ListView.ItemContainerTransitions>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="IsTabStop" Value="False" />
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>

            <StackPanel
                x:Name="EmptyState"
                MaxWidth="360"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="10">
                <FontIcon
                    HorizontalAlignment="Center"
                    FontSize="42"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE943;" />
                <TextBlock
                    AutomationProperties.AutomationId="ScheduledTaskEmptyState"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="还没有脚本"
                    TextAlignment="Center" />
            </StackPanel>

            <InfoBar
                x:Name="ErrorBar"
                Margin="0,8,0,8"
                VerticalAlignment="Top"
                AutomationProperties.AutomationId="ScheduledTaskErrorBar"
                IsClosable="True"
                IsOpen="False"
                Severity="Error"
                Title="操作失败" />
        </Grid>
    </Grid>
</Page>
