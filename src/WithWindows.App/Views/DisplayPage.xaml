<Page
    x:Class="WithWindows.Views.DisplayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WithWindows.Controls">

    <ScrollViewer
        x:Name="PageScroll"
        Padding="24"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled">
        <StackPanel Spacing="16">
            <!-- 与 PowerToys 一致：内容铺开到可用宽度，上限 1200 DIP 并水平居中 -->
            <StackPanel
                Width="{Binding ViewportWidth, ElementName=PageScroll}"
                MaxWidth="1200"
                HorizontalAlignment="Center"
                Spacing="8">
                <TextBlock
                    Margin="0,0,0,8"
                    AutomationProperties.AutomationId="DisplayTitle"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="投影" />

                <controls:CardRow
                    AutomationProperties.AutomationId="DisplayEnabledCard"
                    Glyph="&#xE7E8;"
                    Title="启用功能">
                    <controls:CardRow.Trailing>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock
                                x:Name="EnabledStateText"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="关" />
                            <ToggleSwitch
                                x:Name="EnabledToggle"
                                AutomationProperties.AutomationId="DisplayEnabledToggle"
                                MinWidth="0"
                                OffContent=""
                                OnContent=""
                                Toggled="OnEnabledToggled" />
                        </StackPanel>
                    </controls:CardRow.Trailing>
                </controls:CardRow>

                <controls:HotkeyRow
                    x:Name="DisplayHotkeyRow"
                    Glyph="&#xE765;"
                    Title="快捷键"
                    ToolId="display_mode" />

                <!-- 切换模式：默认折叠，展开后是原生多选框（PowerToys 的 SettingsExpander 风格） -->
                <Expander
                    Margin="0,8,0,0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    AutomationProperties.AutomationId="DisplayModesExpander"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    IsExpanded="True">
                    <Expander.Header>
                        <!--
                            与上方卡片行同构：图标 + 标题（+ 说明）。水平内边距必须给 0——
                            展开组件的头部本身会先留 16 DIP，再叠一层 16 就会比卡片行的图标右移一格。
                        -->
                        <Grid
                            MinHeight="{StaticResource SettingCardMinHeight}"
                            Padding="0,12"
                            ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- E7F9 = DeviceMonitorRightPic，与左栏「投影」项同一个字形 -->
                            <FontIcon
                                Grid.Column="0"
                                FontSize="20"
                                Glyph="&#xE7F9;"
                                VerticalAlignment="Center" />

                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock
                                    AutomationProperties.AutomationId="DisplayModesTitle"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="切换模式" />
                                <TextBlock
                                    x:Name="CurrentModeText"
                                    AutomationProperties.AutomationId="DisplayCurrentMode"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="当前模式：读取中…" />
                            </StackPanel>
                        </Grid>
                    </Expander.Header>

                    <!--
                        子选项与标题文字左对齐（展开组件的内容区左边缘即卡片左边缘，
                        标题在图标之后 = 52 DIP），这样看起来是「切换模式」下的一层子项。
                    -->
                    <StackPanel x:Name="ModesHost" Margin="52,4,16,12" Spacing="2" />
                </Expander>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
