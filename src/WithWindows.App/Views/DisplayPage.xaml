<Page
    x:Class="WithWindows.Views.DisplayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WithWindows.Controls">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16">
            <TextBlock
                AutomationProperties.AutomationId="DisplayTitle"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="投屏" />

            <TextBlock
                x:Name="CurrentModeText"
                AutomationProperties.AutomationId="DisplayCurrentMode"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}" />

            <!-- 投屏快捷键 -->
            <controls:HotkeyRow
                x:Name="DisplayHotkeyRow"
                RunButtonText="立即执行"
                Title="投屏快捷键"
                ToolId="display_mode" />

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="候选模式" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="「立即执行」在这些模式之间循环；至少保留一项。"
                TextWrapping="Wrap" />
            <StackPanel x:Name="ModesHost" Spacing="4" />
        </StackPanel>
    </ScrollViewer>
</Page>
