<Page
    x:Class="WithWindows.Views.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WithWindows.Views"
    xmlns:controls="using:WithWindows.Controls"
    PreviewKeyDown="OnPageKeyDown">

    <Page.Resources>
        <DataTemplate x:Key="MessageAttachmentTemplate" x:DataType="local:ChatAttachmentViewModel">
            <Border
                CornerRadius="6"
                ToolTipService.ToolTip="{x:Bind DetailText}">
                <Image
                    Width="104"
                    Height="78"
                    Source="{x:Bind Preview}"
                    Stretch="UniformToFill" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="PendingAttachmentTemplate" x:DataType="local:ChatAttachmentViewModel">
            <Border
                Margin="0,0,8,0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6"
                ToolTipService.ToolTip="{x:Bind DetailText}">
                <Grid>
                    <Image
                        Width="112"
                        Height="76"
                        Source="{x:Bind Preview}"
                        Stretch="UniformToFill" />
                    <Border
                        Padding="6,3"
                        VerticalAlignment="Bottom"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        CornerRadius="0,0,6,6">
                        <TextBlock
                            MaxWidth="100"
                            FontSize="11"
                            Text="{x:Bind DetailText}"
                            TextTrimming="CharacterEllipsis" />
                    </Border>
                    <Button
                        Width="26"
                        Height="26"
                        Margin="2"
                        Padding="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        AutomationProperties.AutomationId="ChatRemoveAttachmentButton"
                        AutomationProperties.Name="移除图片"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderThickness="0"
                        Click="OnRemovePendingAttachmentClick"
                        ToolTipService.ToolTip="移除图片">
                        <FontIcon FontSize="11" Glyph="&#xE711;" />
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ChatMessageTemplate" x:DataType="local:ChatMessageViewModel">
            <Grid Margin="8,4">
                <Border
                    MaxWidth="760"
                    Padding="14,10"
                    HorizontalAlignment="Right"
                    Background="{ThemeResource AccentFillColorSecondaryBrush}"
                    CornerRadius="8"
                    Visibility="{x:Bind UserVisibility}">
                    <StackPanel Spacing="6">
                        <ItemsControl
                            ItemsSource="{x:Bind Attachments}"
                            ItemTemplate="{StaticResource MessageAttachmentTemplate}"
                            Visibility="{x:Bind AttachmentsVisibility}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <TextBlock
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind Content, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind TextVisibility, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <Border
                    MaxWidth="820"
                    Padding="14,10"
                    HorizontalAlignment="Left"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{x:Bind AssistantVisibility}">
                    <controls:MarkdownMessageView
                        IsMarkdown="{x:Bind IsMarkdown, Mode=OneWay}"
                        Text="{x:Bind Content, Mode=OneWay}" />
                </Border>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid
            Padding="16,8"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center" Spacing="1">
                <TextBlock
                    AutomationProperties.AutomationId="ChatPageTitle"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="AI 对话" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock
                        x:Name="ChatModelInfo"
                        AutomationProperties.AutomationId="ChatModelInfo"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="·" />
                    <TextBlock
                        x:Name="ChatContextInfo"
                        AutomationProperties.AutomationId="ChatContextInfo"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                <ProgressRing
                    x:Name="ChatBusyRing"
                    Width="20"
                    Height="20"
                    Margin="0,0,4,0"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="ChatBusyRing"
                    IsActive="False"
                    Visibility="Collapsed" />
                <Button
                    Width="36"
                    Height="32"
                    Padding="0"
                    AutomationProperties.AutomationId="ChatSearchButton"
                    AutomationProperties.Name="搜索对话"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnSearchButtonClick"
                    ToolTipService.ToolTip="搜索对话">
                    <FontIcon FontSize="16" Glyph="&#xE721;" />
                </Button>
                <Button
                    Width="36"
                    Height="32"
                    Padding="0"
                    AutomationProperties.AutomationId="ChatNewSessionButton"
                    AutomationProperties.Name="新建会话"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnNewSessionClick"
                    ToolTipService.ToolTip="新建会话">
                    <FontIcon FontSize="16" Glyph="&#xF429;" />
                </Button>
                <Button
                    Width="36"
                    Height="32"
                    Padding="0"
                    AutomationProperties.AutomationId="ChatConfigureButton"
                    AutomationProperties.Name="配置 AI 服务"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnConfigureClick"
                    ToolTipService.ToolTip="配置 AI 服务">
                    <FontIcon FontSize="16" Glyph="&#xE713;" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid
            x:Name="ChatSearchBar"
            Grid.Row="1"
            Padding="16,6"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            ColumnSpacing="6"
            Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <FontIcon
                VerticalAlignment="Center"
                FontSize="14"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Glyph="&#xE721;" />
            <TextBox
                x:Name="ChatSearchBox"
                Grid.Column="1"
                AutomationProperties.AutomationId="ChatSearchBox"
                PlaceholderText="搜索对话"
                TextChanged="OnSearchTextChanged" />
            <TextBlock
                x:Name="ChatSearchCount"
                Grid.Column="2"
                MinWidth="76"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="输入关键词" />
            <Button
                Grid.Column="4"
                Width="32"
                Height="32"
                Padding="0"
                AutomationProperties.AutomationId="ChatSearchPreviousButton"
                AutomationProperties.Name="上一个搜索结果"
                Background="Transparent"
                BorderThickness="0"
                Click="OnSearchPreviousClick"
                ToolTipService.ToolTip="上一个">
                <FontIcon FontSize="14" Glyph="&#xE74A;" />
            </Button>
            <Button
                Grid.Column="5"
                Width="32"
                Height="32"
                Padding="0"
                AutomationProperties.AutomationId="ChatSearchNextButton"
                AutomationProperties.Name="下一个搜索结果"
                Background="Transparent"
                BorderThickness="0"
                Click="OnSearchNextClick"
                ToolTipService.ToolTip="下一个">
                <FontIcon FontSize="14" Glyph="&#xE74B;" />
            </Button>
            <Button
                Grid.Column="6"
                Width="32"
                Height="32"
                Padding="0"
                AutomationProperties.AutomationId="ChatSearchCloseButton"
                AutomationProperties.Name="关闭搜索"
                Background="Transparent"
                BorderThickness="0"
                Click="OnSearchCloseClick"
                ToolTipService.ToolTip="关闭">
                <FontIcon FontSize="14" Glyph="&#xE711;" />
            </Button>
        </Grid>

        <Grid Grid.Row="2">
            <ListView
                x:Name="MessageList"
                AutomationProperties.AutomationId="ChatMessageList"
                HorizontalContentAlignment="Stretch"
                ItemsSource="{x:Bind Messages}"
                ItemTemplate="{StaticResource ChatMessageTemplate}"
                SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="IsTabStop" Value="False" />
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>

            <TextBlock
                x:Name="ChatEmptyState"
                Margin="32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="ChatEmptyState"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextAlignment="Center"
                TextWrapping="Wrap" />

            <InfoBar
                x:Name="ChatErrorBar"
                Margin="20,12"
                VerticalAlignment="Top"
                AutomationProperties.AutomationId="ChatErrorBar"
                IsClosable="True"
                IsOpen="False"
                Severity="Error" />
        </Grid>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer
                x:Name="PendingAttachmentsBar"
                Padding="16,8,16,0"
                HorizontalScrollBarVisibility="Auto"
                HorizontalScrollMode="Enabled"
                VerticalScrollBarVisibility="Disabled"
                VerticalScrollMode="Disabled"
                Visibility="Collapsed">
                <ItemsControl
                    AutomationProperties.AutomationId="ChatPendingAttachments"
                    ItemsSource="{x:Bind PendingAttachments}"
                    ItemTemplate="{StaticResource PendingAttachmentTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>

            <TextBox
                x:Name="ChatInput"
                Grid.Row="1"
                MinHeight="52"
                MaxHeight="160"
                Margin="0"
                Padding="16,10"
                AcceptsReturn="True"
                AutomationProperties.AutomationId="ChatInput"
                Background="Transparent"
                BorderThickness="0"
                CornerRadius="0"
                Paste="OnInputPaste"
                PlaceholderText="与 AI 对话"
                PreviewKeyDown="OnInputKeyDown"
                TextCompositionEnded="OnTextCompositionEnded"
                TextCompositionStarted="OnTextCompositionStarted"
                TextWrapping="Wrap"
                VerticalContentAlignment="Center" />
        </Grid>
    </Grid>
</Page>
