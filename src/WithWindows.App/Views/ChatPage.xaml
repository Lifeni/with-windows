<Page
    x:Class="WithWindows.Views.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WithWindows.Views"
    xmlns:controls="using:WithWindows.Controls">

    <Page.Resources>
        <DataTemplate x:Key="MessageAttachmentTemplate" x:DataType="local:ChatAttachmentViewModel">
            <Border
                CornerRadius="6"
                ToolTipService.ToolTip="{x:Bind DetailText}">
                <Image
                    Width="104"
                    Height="78"
                    Source="{x:Bind Preview}"
                    Stretch="UniformToFill" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="PendingAttachmentTemplate" x:DataType="local:ChatAttachmentViewModel">
            <Border
                Margin="0,0,8,0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6"
                ToolTipService.ToolTip="{x:Bind DetailText}">
                <Grid>
                    <Image
                        Width="112"
                        Height="76"
                        Source="{x:Bind Preview}"
                        Stretch="UniformToFill" />
                    <Border
                        Padding="6,3"
                        VerticalAlignment="Bottom"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        CornerRadius="0,0,6,6">
                        <TextBlock
                            MaxWidth="100"
                            FontSize="11"
                            Text="{x:Bind DetailText}"
                            TextTrimming="CharacterEllipsis" />
                    </Border>
                    <Button
                        Width="26"
                        Height="26"
                        Margin="2"
                        Padding="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        AutomationProperties.AutomationId="ChatRemoveAttachmentButton"
                        AutomationProperties.Name="移除图片"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderThickness="0"
                        Click="OnRemovePendingAttachmentClick"
                        ToolTipService.ToolTip="移除图片">
                        <FontIcon FontSize="11" Glyph="&#xE711;" />
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ChatMessageTemplate" x:DataType="local:ChatMessageViewModel">
            <Grid Margin="8,4">
                <Border
                    MaxWidth="760"
                    Padding="14,10"
                    HorizontalAlignment="Right"
                    Background="{ThemeResource AccentFillColorSecondaryBrush}"
                    CornerRadius="8"
                    Visibility="{x:Bind UserVisibility}">
                    <StackPanel Spacing="6">
                        <ItemsControl
                            ItemsSource="{x:Bind Attachments}"
                            ItemTemplate="{StaticResource MessageAttachmentTemplate}"
                            Visibility="{x:Bind AttachmentsVisibility}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <TextBlock
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind Content, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind TextVisibility, Mode=OneWay}" />
                        <Button
                            Padding="4"
                            HorizontalAlignment="Right"
                            AutomationProperties.AutomationId="{x:Bind CopyAutomationId}"
                            AutomationProperties.Name="复制用户消息"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnCopyMessageClick"
                            IsEnabled="{x:Bind CanCopy, Mode=OneWay}"
                            Tag="{x:Bind Content, Mode=OneWay}"
                            ToolTipService.ToolTip="复制">
                            <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                        </Button>
                    </StackPanel>
                </Border>

                <Border
                    MaxWidth="820"
                    Padding="14,10"
                    HorizontalAlignment="Left"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{x:Bind AssistantVisibility}">
                    <StackPanel Spacing="6">
                        <controls:MarkdownMessageView
                            IsMarkdown="{x:Bind IsMarkdown, Mode=OneWay}"
                            Text="{x:Bind Content, Mode=OneWay}" />
                        <Button
                            Padding="4"
                            HorizontalAlignment="Right"
                            AutomationProperties.AutomationId="{x:Bind CopyAutomationId}"
                            AutomationProperties.Name="复制 AI 回复"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnCopyMessageClick"
                            IsEnabled="{x:Bind CanCopy, Mode=OneWay}"
                            Tag="{x:Bind Content, Mode=OneWay}"
                            ToolTipService.ToolTip="复制">
                            <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid
            Padding="16,8"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="ChatPageTitle"
                FontSize="18"
                FontWeight="SemiBold"
                Text="AI 对话" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                <Button
                    x:Name="ChatAttachImageButton"
                    Width="36"
                    Height="32"
                    Padding="0"
                    AutomationProperties.AutomationId="ChatNewSessionButton"
                    AutomationProperties.Name="新建会话"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnNewSessionClick"
                    ToolTipService.ToolTip="新建会话">
                    <FontIcon FontSize="16" Glyph="&#xF429;" />
                </Button>
                <Button
                    Width="36"
                    Height="32"
                    Padding="0"
                    AutomationProperties.AutomationId="ChatConfigureButton"
                    AutomationProperties.Name="配置 AI 服务"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnConfigureClick"
                    ToolTipService.ToolTip="配置 AI 服务">
                    <FontIcon FontSize="16" Glyph="&#xE713;" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <ListView
                x:Name="MessageList"
                AutomationProperties.AutomationId="ChatMessageList"
                HorizontalContentAlignment="Stretch"
                ItemsSource="{x:Bind Messages}"
                ItemTemplate="{StaticResource ChatMessageTemplate}"
                SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="IsTabStop" Value="False" />
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>

            <TextBlock
                x:Name="ChatEmptyState"
                Margin="32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="ChatEmptyState"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="配置 OpenAI 兼容接口后，开始新的对话。"
                TextAlignment="Center"
                TextWrapping="Wrap" />

            <InfoBar
                x:Name="ChatErrorBar"
                Margin="20,12"
                VerticalAlignment="Top"
                AutomationProperties.AutomationId="ChatErrorBar"
                IsClosable="True"
                IsOpen="False"
                Severity="Error" />
        </Grid>

        <Grid
            Grid.Row="2"
            Padding="16,10"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer
                x:Name="PendingAttachmentsBar"
                Margin="0,0,0,8"
                HorizontalScrollBarVisibility="Auto"
                HorizontalScrollMode="Enabled"
                VerticalScrollBarVisibility="Disabled"
                VerticalScrollMode="Disabled"
                Visibility="Collapsed">
                <ItemsControl
                    AutomationProperties.AutomationId="ChatPendingAttachments"
                    ItemsSource="{x:Bind PendingAttachments}"
                    ItemTemplate="{StaticResource PendingAttachmentTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>

            <Grid Grid.Row="1" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button
                    Width="36"
                    Height="32"
                    Padding="0"
                    VerticalAlignment="Bottom"
                    AutomationProperties.AutomationId="ChatAttachImageButton"
                    AutomationProperties.Name="粘贴图片"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnAttachImageClick"
                    ToolTipService.ToolTip="粘贴剪贴板图片">
                    <FontIcon FontSize="16" Glyph="&#xE723;" />
                </Button>

                <TextBox
                    x:Name="ChatInput"
                    Grid.Column="1"
                    MinHeight="42"
                    MaxHeight="140"
                    AcceptsReturn="True"
                    AutomationProperties.AutomationId="ChatInput"
                    KeyDown="OnInputKeyDown"
                    Paste="OnInputPaste"
                    PlaceholderText="输入消息；Ctrl+V 可粘贴图片；Enter 发送"
                    TextCompositionEnded="OnTextCompositionEnded"
                    TextCompositionStarted="OnTextCompositionStarted"
                    TextWrapping="Wrap"
                    VerticalContentAlignment="Center" />

                <ProgressRing
                    x:Name="ChatAttachmentProgress"
                    Grid.Column="2"
                    Width="20"
                    Height="20"
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="ChatAttachmentProgress"
                    IsActive="False"
                    Visibility="Collapsed" />

                <Button
                    x:Name="ChatSendButton"
                    Grid.Column="3"
                    MinWidth="76"
                    VerticalAlignment="Bottom"
                    AutomationProperties.AutomationId="ChatSendButton"
                    AutomationProperties.Name="发送消息"
                    Click="OnSendOrStopClick"
                    Content="发送" />
            </Grid>
        </Grid>
    </Grid>
</Page>
