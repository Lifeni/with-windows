<Page
    x:Class="WithWindows.Views.NotepadPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <!-- 编辑器不要边框、也不要聚焦时的高亮下划线：把模板用到的这几个键在本页覆盖掉 -->
        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
        <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
        <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
        <!-- 「自动换行」用纯文字样式：去掉 ToggleButton 勾选态的实心填充与边框 -->
        <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="Transparent" />
        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="Transparent" />
        <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent" />
        <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="Transparent" />
        <!-- 勾选态前景必须一起覆盖：模板在 Checked 状态把文字设成「强调色上的文字」
             （浅色主题为白、深色主题为黑），背景透明时会变成白字压白底 / 黑字压深灰 -->
        <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="AccentTextFillColorPrimaryBrush" />
        <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="AccentTextFillColorSecondaryBrush" />
        <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="AccentTextFillColorTertiaryBrush" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 常用快捷键：Ctrl+F / Ctrl+H 打开查找替换，Ctrl+S 另存为 -->
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator
                Key="F"
                Invoked="OnFindAccelerator"
                Modifiers="Control" />
            <KeyboardAccelerator
                Key="H"
                Invoked="OnFindAccelerator"
                Modifiers="Control" />
            <KeyboardAccelerator
                Key="S"
                Invoked="OnSaveAsAccelerator"
                Modifiers="Control" />
        </Grid.KeyboardAccelerators>

        <!--
            顶部工具条：左侧秒级时间，右侧三个窄图标按钮（保存 / 复制 / 粘贴）。
            不用 CommandBar：它的命令容器有 68 DIP 的固定最小宽度，压不下去。
        -->
        <Grid
            x:Name="NotepadToolbar"
            Grid.Row="0"
            Padding="16,8"
            AutomationProperties.AutomationId="NotepadToolbar"
            Background="{ThemeResource LayerFillColorDefaultBrush}">
            <TextBlock
                x:Name="ClockText"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="NotepadClock"
                FontSize="18"
                FontWeight="SemiBold" />

            <!-- 格式与动作按钮在工具条里居中（对齐系统记事本） -->
            <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                Spacing="2"
                VerticalAlignment="Center">

                <!-- Markdown 格式：标题 / 列表下拉 + 粗体 / 斜体 / 删除线 / 链接 / 清除格式（对齐系统记事本） -->
                <Button
                    Height="32"
                    Padding="10,0"
                    AutomationProperties.AutomationId="NotepadHeading"
                    AutomationProperties.Name="标题"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTipService.ToolTip="标题">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="H1" FontWeight="SemiBold" />
                        <FontIcon FontSize="10" Glyph="&#xE70D;" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutItem
                                AutomationProperties.AutomationId="HeadingBody"
                                Click="OnHeadingBodyClick"
                                Text="正文" />
                            <MenuFlyoutItem
                                AutomationProperties.AutomationId="Heading1"
                                Click="OnHeading1Click"
                                Text="标题 1" />
                            <MenuFlyoutItem
                                AutomationProperties.AutomationId="Heading2"
                                Click="OnHeading2Click"
                                Text="标题 2" />
                            <MenuFlyoutItem
                                AutomationProperties.AutomationId="Heading3"
                                Click="OnHeading3Click"
                                Text="标题 3" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <Button
                    Height="32"
                    Padding="10,0"
                    AutomationProperties.AutomationId="NotepadList"
                    AutomationProperties.Name="列表"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTipService.ToolTip="列表">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon FontSize="16" Glyph="&#xE8FD;" />
                        <FontIcon FontSize="10" Glyph="&#xE70D;" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutItem
                                AutomationProperties.AutomationId="ListNone"
                                Click="OnListNoneClick"
                                Text="无列表" />
                            <MenuFlyoutItem
                                AutomationProperties.AutomationId="ListBulleted"
                                Click="OnListBulletedClick"
                                Text="项目符号" />
                            <MenuFlyoutItem
                                AutomationProperties.AutomationId="ListNumbered"
                                Click="OnListNumberedClick"
                                Text="编号" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <Button
                    Width="36"
                    Height="32"
                    Padding="0"
                    AutomationProperties.AutomationId="NotepadBold"
                    AutomationProperties.Name="粗体"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnBoldClick"
                    ToolTipService.ToolTip="粗体（Ctrl+B）">
                    <FontIcon FontSize="16" Glyph="&#xE8DD;" />
                </Button>

                <Button
                    Width="36"
                    Height="32"
                    Padding="0"
                    AutomationProperties.AutomationId="NotepadItalic"
                    AutomationProperties.Name="斜体"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnItalicClick"
                    ToolTipService.ToolTip="斜体（Ctrl+I）">
                    <FontIcon FontSize="16" Glyph="&#xE8DB;" />
                </Button>

                <Button
                    Width="36"
                    Height="32"
                    Padding="0"
                    AutomationProperties.AutomationId="NotepadStrikethrough"
                    AutomationProperties.Name="删除线"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnStrikethroughClick"
                    ToolTipService.ToolTip="删除线">
                    <FontIcon FontSize="16" Glyph="&#xEDE0;" />
                </Button>

                <Button
                    Width="36"
                    Height="32"
                    Padding="0"
                    AutomationProperties.AutomationId="NotepadLink"
                    AutomationProperties.Name="插入链接"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnLinkClick"
                    ToolTipService.ToolTip="插入链接">
                    <FontIcon FontSize="16" Glyph="&#xE71B;" />
                </Button>

                <Button
                    Width="36"
                    Height="32"
                    Padding="0"
                    AutomationProperties.AutomationId="NotepadClearFormat"
                    AutomationProperties.Name="清除格式"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnClearFormatClick"
                    ToolTipService.ToolTip="清除格式">
                    <FontIcon FontSize="16" Glyph="&#xEC34;" />
                </Button>

                <!-- 查找替换 -->
                <Button
                    Width="36"
                    Height="32"
                    Padding="0"
                    AutomationProperties.AutomationId="NotepadFind"
                    AutomationProperties.Name="查找替换"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnFindClick"
                    ToolTipService.ToolTip="查找替换（Ctrl+F / Ctrl+H）">
                    <FontIcon FontSize="16" Glyph="&#xE721;" />
                </Button>

                <Button
                    Width="36"
                    Height="32"
                    Padding="0"
                    AutomationProperties.AutomationId="NotepadSave"
                    AutomationProperties.Name="另存为"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnSaveAsClick"
                    ToolTipService.ToolTip="另存为（正文自动保存）">
                    <FontIcon FontSize="16" Glyph="&#xE74E;" />
                </Button>

                <Button
                    Width="36"
                    Height="32"
                    Padding="0"
                    AutomationProperties.AutomationId="NotepadCopy"
                    AutomationProperties.Name="复制"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnCopyClick"
                    ToolTipService.ToolTip="复制">
                    <FontIcon FontSize="16" Glyph="&#xE8C8;" />
                </Button>

                <Button
                    Width="36"
                    Height="32"
                    Padding="0"
                    AutomationProperties.AutomationId="NotepadPaste"
                    AutomationProperties.Name="粘贴"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnPasteClick"
                    ToolTipService.ToolTip="粘贴">
                    <FontIcon FontSize="16" Glyph="&#xE77F;" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- 编辑区占满整页 -->
        <RichEditBox
            x:Name="Editor"
            Grid.Row="1"
            AutomationProperties.AutomationId="NotepadEditor"
            AcceptsReturn="True"
            Background="Transparent"
            BorderThickness="0"
            IsSpellCheckEnabled="False"
            Padding="16,12"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            SelectionChanged="OnEditorSelectionChanged"
            TextChanged="OnEditorTextChanged"
            TextWrapping="Wrap"
            UseSystemFocusVisuals="False" />

        <!-- 查找替换：浮动面板（模仿系统记事本：查找行 + 替换行） -->
        <Border
            x:Name="FindPanel"
            Grid.Row="1"
            Margin="0,16,0,0"
            Padding="16"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            AutomationProperties.AutomationId="FindPanel"
            Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Visibility="Collapsed">
            <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBox
                        x:Name="FindBox"
                        Width="360"
                        AutomationProperties.AutomationId="FindBox"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        KeyDown="OnFindBoxKeyDown"
                        PlaceholderText="查找" />

                    <Button
                        Width="36"
                        Height="32"
                        Padding="0"
                        AutomationProperties.AutomationId="FindPrevButton"
                        AutomationProperties.Name="上一个"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnFindPrevClick"
                        ToolTipService.ToolTip="上一个">
                        <FontIcon FontSize="14" Glyph="&#xE70E;" />
                    </Button>

                    <Button
                        Width="36"
                        Height="32"
                        Padding="0"
                        AutomationProperties.AutomationId="FindNextButton"
                        AutomationProperties.Name="下一个"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnFindNextClick"
                        ToolTipService.ToolTip="下一个">
                        <FontIcon FontSize="14" Glyph="&#xE70D;" />
                    </Button>

                    <CheckBox
                        x:Name="FindMatchCase"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="FindMatchCase"
                        Content="区分大小写" />

                    <Button
                        Width="36"
                        Height="32"
                        Padding="0"
                        AutomationProperties.AutomationId="FindCloseButton"
                        AutomationProperties.Name="关闭查找"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnFindCloseClick"
                        ToolTipService.ToolTip="关闭">
                        <FontIcon FontSize="14" Glyph="&#xE711;" />
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBox
                        x:Name="ReplaceBox"
                        Width="360"
                        AutomationProperties.AutomationId="ReplaceBox"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        KeyDown="OnReplaceBoxKeyDown"
                        PlaceholderText="替换" />

                    <Button
                        AutomationProperties.AutomationId="ReplaceButton"
                        Click="OnReplaceClick"
                        Content="替换" />

                    <Button
                        AutomationProperties.AutomationId="ReplaceAllButton"
                        Click="OnReplaceAllClick"
                        Content="全部替换" />
                </StackPanel>

                <TextBlock
                    x:Name="FindStatus"
                    AutomationProperties.AutomationId="FindStatus"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
        </Border>

        <!-- 底部状态栏：行列 / 字符数 / 缩放 -->
        <Grid
            Grid.Row="2"
            Padding="16,6"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                x:Name="StatusCaret"
                Grid.Column="0"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="NotepadStatusCaret"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}" />

            <TextBlock
                x:Name="StatusCount"
                Grid.Column="1"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="NotepadStatusCount"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}" />

            <!-- 自动换行：状态栏里的文字开关，勾选时前面显示对勾 -->
            <ToggleButton
                x:Name="WrapToggle"
                Grid.Column="2"
                Margin="16,0,0,0"
                Padding="6,2"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="NotepadWrap"
                AutomationProperties.Name="自动换行"
                Background="Transparent"
                BorderThickness="0"
                Checked="OnWrapToggled"
                FontSize="12"
                IsChecked="True"
                Unchecked="OnWrapToggled">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <!-- 未开启时保留占位（透明而不是折叠），否则文字会左右跳 -->
                    <FontIcon
                        x:Name="WrapCheck"
                        FontSize="12"
                        Glyph="&#xE73E;"
                        VerticalAlignment="Center" />
                    <TextBlock Text="自动换行" VerticalAlignment="Center" />
                </StackPanel>
            </ToggleButton>

            <TextBlock
                x:Name="StatusZoom"
                Grid.Column="3"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="NotepadStatusZoom"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>
    </Grid>
</Page>
