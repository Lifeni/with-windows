<Page
    x:Class="WithWindows.Views.NotepadPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <!-- 编辑器不要边框、也不要聚焦时的高亮下划线：把模板用到的这几个键在本页覆盖掉 -->
        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
        <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
        <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
        <!-- 「自动换行」用纯文字样式：去掉 ToggleButton 勾选态的实心填充与边框 -->
        <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="Transparent" />
        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="Transparent" />
        <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent" />
        <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="Transparent" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            顶部工具条：左侧秒级时间，右侧三个窄图标按钮（保存 / 复制 / 粘贴）。
            不用 CommandBar：它的命令容器有 68 DIP 的固定最小宽度，压不下去。
        -->
        <Grid
            x:Name="NotepadToolbar"
            Grid.Row="0"
            Padding="16,8"
            AutomationProperties.AutomationId="NotepadToolbar"
            Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                x:Name="ClockText"
                Grid.Column="0"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="NotepadClock"
                FontSize="18"
                FontWeight="SemiBold" />

            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="2"
                VerticalAlignment="Center">

                <Button
                    Width="36"
                    Height="32"
                    Padding="0"
                    AutomationProperties.AutomationId="NotepadSave"
                    AutomationProperties.Name="保存"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnSaveClick"
                    ToolTipService.ToolTip="保存">
                    <FontIcon FontSize="16" Glyph="&#xE74E;" />
                </Button>

                <Button
                    Width="36"
                    Height="32"
                    Padding="0"
                    AutomationProperties.AutomationId="NotepadCopy"
                    AutomationProperties.Name="复制"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnCopyClick"
                    ToolTipService.ToolTip="复制">
                    <FontIcon FontSize="16" Glyph="&#xE8C8;" />
                </Button>

                <Button
                    Width="36"
                    Height="32"
                    Padding="0"
                    AutomationProperties.AutomationId="NotepadPaste"
                    AutomationProperties.Name="粘贴"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnPasteClick"
                    ToolTipService.ToolTip="粘贴">
                    <FontIcon FontSize="16" Glyph="&#xE77F;" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- 编辑区占满整页 -->
        <RichEditBox
            x:Name="Editor"
            Grid.Row="1"
            AutomationProperties.AutomationId="NotepadEditor"
            AcceptsReturn="True"
            Background="Transparent"
            BorderThickness="0"
            IsSpellCheckEnabled="False"
            Padding="16,12"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            SelectionChanged="OnEditorSelectionChanged"
            TextChanged="OnEditorTextChanged"
            TextWrapping="Wrap"
            UseSystemFocusVisuals="False" />

        <!-- 底部状态栏：行列 / 字符数 / 缩放 -->
        <Grid
            Grid.Row="2"
            Padding="16,6"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                x:Name="StatusCaret"
                Grid.Column="0"
                AutomationProperties.AutomationId="NotepadStatusCaret"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}" />

            <TextBlock
                x:Name="StatusCount"
                Grid.Column="1"
                AutomationProperties.AutomationId="NotepadStatusCount"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}" />

            <!-- 自动换行：状态栏里的文字样式开关 -->
            <ToggleButton
                x:Name="WrapToggle"
                Grid.Column="2"
                Margin="16,0,0,0"
                Padding="8,2"
                HorizontalAlignment="Left"
                AutomationProperties.AutomationId="NotepadWrap"
                AutomationProperties.Name="自动换行"
                Background="Transparent"
                BorderThickness="0"
                Checked="OnWrapToggled"
                Content="自动换行"
                FontSize="12"
                IsChecked="True"
                Unchecked="OnWrapToggled" />

            <TextBlock
                x:Name="StatusZoom"
                Grid.Column="3"
                HorizontalAlignment="Right"
                AutomationProperties.AutomationId="NotepadStatusZoom"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>
    </Grid>
</Page>
