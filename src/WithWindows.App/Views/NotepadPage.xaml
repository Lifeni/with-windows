<Page
    x:Class="WithWindows.Views.NotepadPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <!--
            注意：编辑器那组 TextControl* 覆盖**不能放在页面级**——那样连查找面板里的 TextBox
            聚焦时背景也会变成透明、与面板糊在一起（实际踩过）。它们放在下面 RichEditBox 自己的 Resources 里。
        -->
        <!-- 「自动换行」用纯文字样式：去掉 ToggleButton 勾选态的实心填充与边框 -->
        <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="Transparent" />
        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="Transparent" />
        <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent" />
        <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="Transparent" />
        <!-- 勾选态前景必须一起覆盖：模板在 Checked 状态把文字设成「强调色上的文字」
             （浅色主题为白、深色主题为黑），背景透明时会变成白字压白底 / 黑字压深灰 -->
        <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="AccentTextFillColorPrimaryBrush" />
        <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="AccentTextFillColorSecondaryBrush" />
        <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="AccentTextFillColorTertiaryBrush" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            常用快捷键（Ctrl+F 查找、Ctrl+H 替换、Ctrl+S 另存为）在 code-behind 里用 KeyDown 处理，
            不用 KeyboardAccelerator：加速键会在鼠标悬停时自动弹「Ctrl+F」小提示，
            而它挂在页面根元素上，鼠标移到编辑区任何位置都会冒出来。
        -->

        <!--
            顶部工具条：左侧秒级时间，右侧实用按钮（查找替换 / 另存为）——不做格式化按钮组，
            加粗 / 斜体 / 下划线由编辑器原生快捷键提供。
            不用 CommandBar：它的命令容器有 68 DIP 的固定最小宽度，压不下去。
        -->
        <Grid
            x:Name="NotepadToolbar"
            Grid.Row="0"
            Padding="16,8"
            AutomationProperties.AutomationId="NotepadToolbar"
            Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                x:Name="ClockText"
                Grid.Column="0"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="NotepadClock"
                FontSize="18"
                FontWeight="SemiBold" />

            <!-- 实用按钮右对齐：查找替换 / 另存为 -->
            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="2"
                VerticalAlignment="Center">

                <!-- 查找替换 -->
                <Button
                    Width="36"
                    Height="32"
                    Padding="0"
                    AutomationProperties.AutomationId="NotepadFind"
                    AutomationProperties.Name="查找替换"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnFindClick"
                    ToolTipService.ToolTip="查找替换">
                    <FontIcon FontSize="16" Glyph="&#xE721;" />
                </Button>

                <Button
                    Width="36"
                    Height="32"
                    Padding="0"
                    AutomationProperties.AutomationId="NotepadSave"
                    AutomationProperties.Name="另存为"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnSaveAsClick"
                    ToolTipService.ToolTip="另存为">
                    <FontIcon FontSize="16" Glyph="&#xE74E;" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- 编辑区占满整页 -->
        <RichEditBox
            x:Name="Editor"
            Grid.Row="1"
            AutomationProperties.AutomationId="NotepadEditor"
            AcceptsReturn="True"
            Background="Transparent"
            BorderThickness="0"
            IsSpellCheckEnabled="False"
            Padding="16,12"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            SelectionChanged="OnEditorSelectionChanged"
            SelectionHighlightColorWhenNotFocused="{ThemeResource AccentFillColorDefaultBrush}"
            TextChanged="OnEditorTextChanged"
            TextWrapping="Wrap"
            UseSystemFocusVisuals="False">
            <RichEditBox.Resources>
                <!-- 只作用于编辑器：无边框、聚焦时也不要高亮下划线（原先放页面级，误伤了查找面板的输入框） -->
                <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
            </RichEditBox.Resources>
        </RichEditBox>

        <!--
            查找替换：浮动面板（对齐系统记事本）——默认只有查找行，点最左侧的箭头才展开替换行。
            底色用「三级固体填充」、边框用控件描边，取值与系统记事本一致；
            输入框不额外指定背景色，走主题默认（未聚焦是浅色填充、聚焦是输入态深色底），不会和面板糊在一起。
        -->
        <Border
            x:Name="FindPanel"
            Grid.Row="1"
            Margin="0,16,0,0"
            Padding="12"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            AutomationProperties.AutomationId="FindPanel"
            Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Visibility="Collapsed">
            <StackPanel Spacing="8">
                <!-- 查找行：展开箭头 / 输入框 / 下一个 / 上一个 / 选项 / 关闭 -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button
                        x:Name="FindExpandButton"
                        Grid.Column="0"
                        Width="32"
                        Height="32"
                        Padding="0"
                        AutomationProperties.AutomationId="FindExpandButton"
                        AutomationProperties.Name="展开替换"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnFindExpandClick"
                        ToolTipService.ToolTip="展开替换">
                        <FontIcon x:Name="FindExpandIcon" FontSize="12" Glyph="&#xE70E;" />
                    </Button>

                    <TextBox
                        x:Name="FindBox"
                        Grid.Column="1"
                        AutomationProperties.AutomationId="FindBox"
                        KeyDown="OnFindBoxKeyDown"
                        TextChanged="OnFindBoxTextChanged"
                        PlaceholderText="查找" />

                    <StackPanel
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">

                        <Button
                            Width="32"
                            Height="32"
                            Padding="0"
                            AutomationProperties.AutomationId="FindNextButton"
                            AutomationProperties.Name="下一个"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnFindNextClick"
                            ToolTipService.ToolTip="下一个">
                            <FontIcon FontSize="16" Glyph="&#xE74B;" />
                        </Button>

                        <Button
                            Width="32"
                            Height="32"
                            Padding="0"
                            AutomationProperties.AutomationId="FindPrevButton"
                            AutomationProperties.Name="上一个"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnFindPrevClick"
                            ToolTipService.ToolTip="上一个">
                            <FontIcon FontSize="16" Glyph="&#xE74A;" />
                        </Button>

                        <!-- 选项：系统记事本放在条上的「滑块」图标里，点开是区分大小写等开关 -->
                        <Button
                            x:Name="FindOptionsButton"
                            Width="32"
                            Height="32"
                            Padding="0"
                            AutomationProperties.AutomationId="FindOptionsButton"
                            AutomationProperties.Name="查找选项"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTipService.ToolTip="查找选项">
                            <FontIcon FontSize="16" Glyph="&#xE9E9;" />
                            <Button.Flyout>
                                <MenuFlyout Placement="Bottom">
                                    <ToggleMenuFlyoutItem
                                        x:Name="FindMatchCase"
                                        AutomationProperties.AutomationId="FindMatchCase"
                                        Text="区分大小写" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>

                        <Button
                            Width="32"
                            Height="32"
                            Padding="0"
                            AutomationProperties.AutomationId="FindCloseButton"
                            AutomationProperties.Name="关闭查找"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnFindCloseClick"
                            ToolTipService.ToolTip="关闭">
                            <FontIcon FontSize="16" Glyph="&#xE711;" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 替换行：默认折叠，点最左侧箭头展开 -->
                <Grid x:Name="ReplaceRow" ColumnSpacing="8" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 占位：让替换框与查找框左边缘对齐 -->
                    <Border Grid.Column="0" Width="32" />

                    <TextBox
                        x:Name="ReplaceBox"
                        Grid.Column="1"
                        AutomationProperties.AutomationId="ReplaceBox"
                        KeyDown="OnReplaceBoxKeyDown"
                        PlaceholderText="替换" />

                    <StackPanel
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                        <Button
                            AutomationProperties.AutomationId="ReplaceButton"
                            Click="OnReplaceClick"
                            Content="替换" />

                        <Button
                            AutomationProperties.AutomationId="ReplaceAllButton"
                            Click="OnReplaceAllClick"
                            Content="全部替换" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 底部状态栏：行列 / 字符数 / 缩放 -->
        <Grid
            Grid.Row="2"
            Padding="16,6"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                x:Name="StatusCaret"
                Grid.Column="0"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="NotepadStatusCaret"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}" />

            <TextBlock
                x:Name="StatusCount"
                Grid.Column="1"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="NotepadStatusCount"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}" />

            <!-- 自动换行：状态栏里的文字开关，勾选时前面显示对勾 -->
            <ToggleButton
                x:Name="WrapToggle"
                Grid.Column="2"
                Margin="16,0,0,0"
                Padding="6,2"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="NotepadWrap"
                AutomationProperties.Name="自动换行"
                Background="Transparent"
                BorderThickness="0"
                Checked="OnWrapToggled"
                FontSize="12"
                IsChecked="True"
                Unchecked="OnWrapToggled">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <!-- 未开启时保留占位（透明而不是折叠），否则文字会左右跳 -->
                    <FontIcon
                        x:Name="WrapCheck"
                        FontSize="12"
                        Glyph="&#xE73E;"
                        VerticalAlignment="Center" />
                    <TextBlock Text="自动换行" VerticalAlignment="Center" />
                </StackPanel>
            </ToggleButton>

            <TextBlock
                x:Name="StatusZoom"
                Grid.Column="3"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="NotepadStatusZoom"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>
    </Grid>
</Page>
