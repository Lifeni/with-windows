<UserControl
    x:Class="WithWindows.Controls.LuaCodeEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="6">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0"
                CornerRadius="5,0,0,5">
                <ScrollViewer
                    x:Name="GutterScroll"
                    HorizontalScrollBarVisibility="Hidden"
                    HorizontalScrollMode="Disabled"
                    IsHitTestVisible="False"
                    VerticalScrollBarVisibility="Hidden"
                    VerticalScrollMode="Enabled">
                    <TextBlock
                        x:Name="LineNumbers"
                        Padding="8,8,6,8"
                        FontFamily="Cascadia Mono, Consolas"
                        FontSize="13"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        IsTextSelectionEnabled="False"
                        LineHeight="20"
                        LineStackingStrategy="BlockLineHeight"
                        Text="1"
                        TextAlignment="Right" />
                </ScrollViewer>
            </Border>

            <RichEditBox
                x:Name="Editor"
                Grid.Column="1"
                AcceptsReturn="True"
                AutomationProperties.AutomationId="ScheduledTaskScriptEditor"
                AutomationProperties.Name="Lua 脚本"
                Background="Transparent"
                BorderThickness="0"
                FontFamily="Cascadia Mono, Consolas"
                FontSize="13"
                IsSpellCheckEnabled="False"
                Loaded="OnEditorLoaded"
                Padding="10,8,12,8"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                SelectionHighlightColorWhenNotFocused="{ThemeResource AccentFillColorDefaultBrush}"
                TextChanged="OnEditorTextChanged"
                TextWrapping="NoWrap"
                Unloaded="OnEditorUnloaded"
                UseSystemFocusVisuals="False">
                <RichEditBox.Resources>
                    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                    <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                </RichEditBox.Resources>
            </RichEditBox>
        </Grid>
    </Border>
</UserControl>
