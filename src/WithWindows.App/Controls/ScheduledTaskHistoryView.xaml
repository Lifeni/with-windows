<UserControl
    x:Class="WithWindows.Controls.ScheduledTaskHistoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:WithWindows.Views">

    <UserControl.Resources>
        <DataTemplate x:Key="RunItemTemplate" x:DataType="views:ScheduledTaskRunRowViewModel">
            <TextBlock
                FontSize="12"
                Text="{x:Bind ListText}"
                TextTrimming="CharacterEllipsis" />
        </DataTemplate>

        <Style x:Key="RunListItemStyle" TargetType="ListViewItem">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="8,6" />
        </Style>
    </UserControl.Resources>

    <Grid x:Name="ContentRoot" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock
                FontSize="13"
                FontWeight="SemiBold"
                Text="运行记录" />

            <ListView
                x:Name="RunList"
                Grid.Row="1"
                AutomationProperties.AutomationId="ScheduledTaskRunHistoryList"
                AutomationProperties.Name="运行记录"
                HorizontalContentAlignment="Stretch"
                ItemContainerStyle="{StaticResource RunListItemStyle}"
                ItemTemplate="{StaticResource RunItemTemplate}"
                ItemsSource="{x:Bind Runs}"
                ContainerContentChanging="OnRunContainerContentChanging"
                SelectionChanged="OnRunSelectionChanged"
                SelectionMode="Single" />
        </Grid>

        <Grid
            x:Name="ResultsPanel"
            Grid.Column="1"
            RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock
                x:Name="RunDetailsText"
                AutomationProperties.AutomationId="ScheduledTaskRunDetails"
                FontSize="13"
                FontWeight="SemiBold"
                Text="运行结果"
                TextTrimming="CharacterEllipsis" />

            <Border
                Grid.Row="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <Grid>
                    <ScrollViewer
                        HorizontalScrollBarVisibility="Disabled"
                        HorizontalScrollMode="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        VerticalScrollMode="Enabled">
                        <RichTextBlock
                            x:Name="OutputText"
                            AutomationProperties.AutomationId="ScheduledTaskCombinedOutput"
                            AutomationProperties.Name="运行输出"
                            FontFamily="Cascadia Mono, Consolas"
                            FontSize="12"
                            IsTextSelectionEnabled="True"
                            Padding="10,8"
                            TextWrapping="Wrap" />
                    </ScrollViewer>

                    <TextBlock
                        x:Name="EmptyOutput"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="ScheduledTaskOutputEmptyState"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="暂无输出"
                        Visibility="Collapsed" />
                </Grid>
            </Border>
        </Grid>

        <TextBlock
            x:Name="EmptyRuns"
            Grid.ColumnSpan="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            AutomationProperties.AutomationId="ScheduledTaskRunEmptyState"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="暂无运行记录"
            Visibility="Collapsed" />
    </Grid>
</UserControl>
