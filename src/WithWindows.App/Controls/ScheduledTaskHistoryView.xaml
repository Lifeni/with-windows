<UserControl
    x:Class="WithWindows.Controls.ScheduledTaskHistoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:WithWindows.Views">

    <UserControl.Resources>
        <DataTemplate x:Key="RunExpanderTemplate" x:DataType="views:ScheduledTaskRunRowViewModel">
            <Expander
                AutomationProperties.AutomationId="{x:Bind AutomationId}"
                AutomationProperties.Name="{x:Bind HeaderText}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Collapsed="OnRunExpanderCollapsed"
                CornerRadius="6"
                Expanding="OnRunExpanderExpanding"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                IsExpanded="False"
                Loaded="OnRunExpanderLoaded"
                Padding="14,6,14,14"
                Tag="{x:Bind}"
                Unloaded="OnRunExpanderUnloaded">
                <Expander.Header>
                    <Grid MinHeight="36" Padding="0,6">
                        <TextBlock
                            FontSize="13"
                            FontWeight="SemiBold"
                            Text="{x:Bind HeaderText}"
                            TextTrimming="CharacterEllipsis"
                            VerticalAlignment="Center" />
                    </Grid>
                </Expander.Header>
            </Expander>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer
            x:Name="RunScroll"
            AutomationProperties.AutomationId="ScheduledTaskRunHistoryList"
            AutomationProperties.Name="运行记录"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Enabled">
            <ItemsControl
                x:Name="RunItems"
                HorizontalContentAlignment="Stretch"
                ItemTemplate="{StaticResource RunExpanderTemplate}"
                ItemsSource="{x:Bind Runs}">
                <ItemsControl.ItemContainerTransitions>
                    <TransitionCollection>
                        <AddDeleteThemeTransition />
                        <RepositionThemeTransition />
                    </TransitionCollection>
                </ItemsControl.ItemContainerTransitions>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock
            x:Name="EmptyRuns"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            AutomationProperties.AutomationId="ScheduledTaskRunEmptyState"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="暂无运行记录"
            Visibility="Collapsed" />
    </Grid>
</UserControl>
